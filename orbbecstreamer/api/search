ackages","content":"Downloads the NVIDIA repository key and the Orbbec SDK package below."},"2949":{"id":"/docs/server/install-35","page_id":"/docs/server/install","tags":[],"type":"text","url":"/docs/server/install#system-packages","content":"`bison` … `libxext-dev`"},"2950":{"id":"/docs/server/install-36","page_id":"/docs/server/install","tags":[],"type":"text","url":"/docs/server/install#system-packages","content":"vcpkg builds OpenCV with its GTK dependencies from source. These tools and X11 headers are needed for that."},"2951":{"id":"/docs/server/install-37","page_id":"/docs/server/install","tags":[],"type":"text","url":"/docs/server/install#system-packages","content":"`libffmpeg-nvenc-dev`"},"2952":{"id":"/docs/server/install-38","page_id":"/docs/server/install","tags":[],"type":"text","url":"/docs/server/install#system-packages","content":"NVENC API headers (`ffnvcodec`)."},"2953":{"id":"/docs/server/install-39","page_id":"/docs/server/install","tags":[],"type":"text","url":"/docs/server/install#system-packages","content":"`libavcodec-dev` … `libswscale-dev`"},"2954":{"id":"/docs/server/install-40","page_id":"/docs/server/install","tags":[],"type":"text","url":"/docs/server/install#system-packages","content":"FFmpeg libraries for the local HEVC decoder and the debug recorder."},"2955":{"id":"/docs/server/install-41","page_id":"/docs/server/install","tags":[],"type":"text","url":"/docs/server/install#cuda-toolkit-and-driver","content":"Skip this step if `nvidia-smi` shows driver 580 or newer and\n`/usr/local/cuda/bin/nvcc --version` shows CUDA 13."},"2956":{"id":"/docs/server/install-42","page_id":"/docs/server/install","tags":[],"type":"text","url":"/docs/server/install#cuda-toolkit-and-driver","content":"The commands in this section and in TensorRT have not been run\non a fresh machine. On the reference machine, the CUDA toolkit and TensorRT\ncome from NVIDIA's repository, but the driver is Ubuntu's\n`nvidia-driver-580-server` package."},"2957":{"id":"/docs