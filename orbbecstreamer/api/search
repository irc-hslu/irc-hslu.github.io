d":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`Invalid integer value: <raw>` / `Invalid float value: <raw>`"},"2368":{"id":"/docs/server/configuration-405","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"A number field has trailing text, for example `30fps`."},"2369":{"id":"/docs/server/configuration-406","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`Invalid empty integer value` / `Invalid empty float value`"},"2370":{"id":"/docs/server/configuration-407","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"A number field has no value."},"2371":{"id":"/docs/server/configuration-408","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`Invalid boolean value: <raw>`"},"2372":{"id":"/docs/server/configuration-409","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"Use `true`/`false`, `yes`/`no` or `1`/`0`."},"2373":{"id":"/docs/server/configuration-410","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`stoul` or `stof`"},"2374":{"id":"/docs/server/configuration-411","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"A number field starts with a non-digit, for example `fps: thirty`."},"2375":{"id":"/docs/server/configuration-412","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`live config must contain at least one camera`"},"2376":{"id":"/docs/server/configuration-413","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"Add a `cameras` list item."},"2377":{"id":"/docs/server/configuration-414","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`sync.enabled=true requires exactly one primary camera`"},"2378":{"id":"/docs/server/configuration-415","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"Set `role: primary` on exactly one camera."},"2379":{"id":"/docs/server/configuration-416","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`Encoding currently requires matching color and depth FPS`"},"2380":{"id":"/docs/server/configuration-417","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"Make `streams.color.fps` equal to `streams.depth.fps`."},"2381":{"id":"/docs/server/configuration-418","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`Current RVM integration requires streams.alignment=color_to_depth`"},"2382":{"id":"/docs/server/configuration-419","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"Set `streams.alignment: color_to_depth`, or choose another mask backend."},"2383":{"id":"/docs/server/configuration-420","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`Unsupported live mask backend: <name>` / `Unsupported live depth filter backend: <name>`"},"2384":{"id":"/docs/server/configuration-421","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"Use a value from the `mask` or `processing` tables."},"2385":{"id":"/docs/server/configuration-422","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`Cannot open TensorRT engine: <path>`"},"2386":{"id":"/docs/server/configuration-423","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"The RVM engine has not been built, or `rvm_engine_path` is relative to another directory."},"2387":{"id":"/docs/server/configuration-424","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`Depth quantization profile range does not match live config`"},"2388":{"id":"/docs/server/configuration-425","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"The profile was made for another depth range. Recalibrate with `--force`, or delete the file to use the linear mapping."},"2389":{"id":"/docs/server/configuration-426","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`No configured cameras are active; live mode cannot continue`"},"2390":{"id":"/docs/server/configuration-427","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"No serial number matched a connected camera. Check the cables and `serial_number`; list devices with `./build/dev-debug/orbbec_streamer --orbbec-test`."},"2391":{"id":"/docs/server/configuration-428","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`GPU-output recording requires encoding.enabled=true`"},"2392":{"id":"/docs/server/configuration-429","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"Enable encoding or set `record_gpu_outputs: false`."},"2393":{"id":"/docs/server/configuration-430","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`Debug recording references unknown camera id: <id>`"},"2394":{"id":"/docs/server/configuration-431","page_id":"/docs/server/configuration","tags":[],"type":"text","url":"/docs/server/configuration#troubleshooting","content":"`debug_recording.camera_ids` must use the camera `id`s, not serial numbers."},"2395":{"id":"/docs/server/depth-quantization-calibrator","page_id":"/docs/server/depth-quantization-calibrator","type":"page","content":"Depth quantization calibrator","breadcrumbs":["HSLU OrbbecStreamer","Server","Operate"],"tags":[],"url":"/docs/server/depth-quantization-calibrator"},"2396":{"id":"/docs/server/depth-quantization-calibrator-0","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator","content":"Fit the 10-bit depth code table to your scene with orbbec_streamer_depth_quantization_calibrator."},"2397":{"id":"/docs/server/depth-quantization-calibrator-1","page_id":"/docs/server/depth-quantization-calibrator","type":"heading","tags":[],"url":"/docs/server/depth-quantization-calibrator#code-layout","content":"Code layout"},"2398":{"id":"/docs/server/depth-quantization-calibrator-2","page_id":"/docs/server/depth-quantization-calibrator","type":"heading","tags":[],"url":"/docs/server/depth-quantization-calibrator#how-the-adaptive-profile-is-fitted","content":"How the adaptive profile is fitted"},"2399":{"id":"/docs/server/depth-quantization-calibrator-3","page_id":"/docs/server/depth-quantization-calibrator","type":"heading","tags":[],"url":"/docs/server/depth-quantization-calibrator#run-the-calibrator","content":"Run the calibrator"},"2400":{"id":"/docs/server/depth-quantization-calibrator-4","page_id":"/docs/server/depth-quantization-calibrator","type":"heading","tags":[],"url":"/docs/server/depth-quantization-calibrator#options","content":"Options"},"2401":{"id":"/docs/server/depth-quantization-calibrator-5","page_id":"/docs/server/depth-quantization-calibrator","type":"heading","tags":[],"url":"/docs/server/depth-quantization-calibrator#config-keys-it-reads","content":"Config keys it reads"},"2402":{"id":"/docs/server/depth-quantization-calibrator-6","page_id":"/docs/server/depth-quantization-calibrator","type":"heading","tags":[],"url":"/docs/server/depth-quantization-calibrator#expected-result","content":"Expected result"},"2403":{"id":"/docs/server/depth-quantization-calibrator-7","page_id":"/docs/server/depth-quantization-calibrator","type":"heading","tags":[],"url":"/docs/server/depth-quantization-calibrator#the-profile-file","content":"The profile file"},"2404":{"id":"/docs/server/depth-quantization-calibrator-8","page_id":"/docs/server/depth-quantization-calibrator","type":"heading","tags":[],"url":"/docs/server/depth-quantization-calibrator#what-the-live-server-shows","content":"What the live server shows"},"2405":{"id":"/docs/server/depth-quantization-calibrator-9","page_id":"/docs/server/depth-quantization-calibrator","type":"heading","tags":[],"url":"/docs/server/depth-quantization-calibrator#troubleshooting","content":"Troubleshooting"},"2406":{"id":"/docs/server/depth-quantization-calibrator-10","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator","content":"The depth stream is HEVC Main10, so every depth pixel has to fit in one 10-bit\ncode. A **depth quantization profile** is the table that maps metric depth\n(millimetres) to those codes and back. The server always has one:"},"2407":{"id":"/docs/server/depth-quantization-calibrator-11","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator","content":"**Linear** (the default): the 1021 valid codes are spread evenly over\n`encoding.depth.minimum_depth_mm`..`maximum_depth_mm`. For the default\n500–5000 mm range one code step is about 4.4 mm."},"2408":{"id":"/docs/server/depth-quantization-calibrator-12","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator","content":"**Adaptive quantile**: codes are packed more densely at the depths your\nscene actually uses, so the quantization error is smaller where people are."},"2409":{"id":"/docs/server/depth-quantization-calibrator-13","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator","content":"`orbbec_streamer_depth_quantization_calibrator` captures live depth for up to\n60 seconds, builds a histogram of the masked, filtered foreground depth, and\nwrites an adaptive profile as JSON. The live server loads that file at\nstartup. Without the file, the server uses the linear profile, which is a\nvalid setting: this calibration is optional."},"2410":{"id":"/docs/server/depth-quantization-calibrator-14","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"Every profile uses the same code meanings. Clients decode only through the\ntable that the server sends (`protocol/wire-format.md` §8)."},"2411":{"id":"/docs/server/depth-quantization-calibrator-15","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"Code"},"2412":{"id":"/docs/server/depth-quantization-calibrator-16","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"Meaning"},"2413":{"id":"/docs/server/depth-quantization-calibrator-17","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"`0`"},"2414":{"id":"/docs/server/depth-quantization-calibrator-18","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"Invalid, or outside the foreground mask"},"2415":{"id":"/docs/server/depth-quantization-calibrator-19","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"`1`"},"2416":{"id":"/docs/server/depth-quantization-calibrator-20","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"Closer than `minimum_depth_mm`"},"2417":{"id":"/docs/server/depth-quantization-calibrator-21","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"`2`..`1022`"},"2418":{"id":"/docs/server/depth-quantization-calibrator-22","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"Valid depth: `depth_mm = reconstruction_lut_mm[code]`"},"2419":{"id":"/docs/server/depth-quantization-calibrator-23","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"`1023`"},"2420":{"id":"/docs/server/depth-quantization-calibrator-24","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#code-layout","content":"Farther than `maximum_depth_mm`"},"2421":{"id":"/docs/server/depth-quantization-calibrator-25","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#how-the-adaptive-profile-is-fitted","content":"For the first `setup.warmup_seconds` nothing is collected."},"2422":{"id":"/docs/server/depth-quantization-calibrator-26","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#how-the-adaptive-profile-is-fitted","content":"For the rest of the run, the calibrator counts every depth pixel whose\nforeground mask value is at least `processing.bilateral_mask_threshold` and\nwhose depth is inside the configured range. Invalid, too-close and too-far\npixels are counted separately and are not used for the fit."},"2423":{"id":"/docs/server/depth-quantization-calibrator-27","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#how-the-adaptive-profile-is-fitted","content":"The histogram is mixed with a uniform distribution over the range. With\n`--uniform-mix 0.5`, about half the codebook still covers the whole range\nevenly and the other half follows your scene. `0` means fully\ndata-driven and `1` means linear."},"2424":{"id":"/docs/server/depth-quantization-calibrator-28","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#how-the-adaptive-profile-is-fitted","content":"Code values are placed at the quantiles of that mixture. When the range\nhas at least 1021 distinct millimetre values (500–5000 mm has 4501), every\nvalid code gets its own reconstruction value, so no code is wasted."},"2425":{"id":"/docs/server/depth-quantization-calibrator-29","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#how-the-adaptive-profile-is-fitted","content":"The calibrator computes the expected mean absolute error of the adaptive\nprofile and of the linear profile on the same histogram, and **saves the\none with the lower error**. The result can therefore be `linear` even after\na successful run."},"2426":{"id":"/docs/server/depth-quantization-calibrator-30","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#how-the-adaptive-profile-is-fitted","content":"The calibrator runs the same camera sync, GPU upload, foreground mask and\ndepth filter as the live server, but no encoder, preview or debug recording.\nIf `mask.backend` is `none` it uses `fill_all` (every pixel is foreground); if\n`processing.depth_filter_backend` is `none` it passes depth through unfiltered."},"2427":{"id":"/docs/server/depth-quantization-calibrator-31","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#run-the-calibrator","content":"The calibrator opens the cameras, so it needs the same hardware as a live run."},"2428":{"id":"/docs/server/depth-quantization-calibrator-32","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#run-the-calibrator","content":"Build it. Work in the `server/` folder of your checkout:"},"2429":{"id":"/docs/server/depth-quantization-calibrator-33","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#run-the-calibrator","content":"Stop any other process that uses the cameras, such as a running\n`orbbec_streamer --live`."},"2430":{"id":"/docs/server/depth-quantization-calibrator-34","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#run-the-calibrator","content":"Make sure the cameras in `config/dev/live.yaml` are connected, and that\nthe scene looks like a real session: people standing where they will stand\nduring a call. Only foreground pixels are counted."},"2431":{"id":"/docs/server/depth-quantization-calibrator-35","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#run-the-calibrator","content":"Run it from `server/` (relative paths in the config and the default\n`--config` value are resolved against the working directory):"},"2432":{"id":"/docs/server/depth-quantization-calibrator-36","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#run-the-calibrator","content":"If a profile with a matching range already exists, the calibrator reuses it\nand exits without opening the cameras. To replace it, add `--force`:"},"2433":{"id":"/docs/server/depth-quantization-calibrator-37","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#run-the-calibrator","content":"Move around the capture area while it runs. Press Ctrl+C to stop early;\nthe profile is still fitted from the samples collected so far."},"2434":{"id":"/docs/server/depth-quantization-calibrator-38","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#run-the-calibrator","content":"Restart the live server. It reads the profile only at startup."},"2435":{"id":"/docs/server/depth-quantization-calibrator-39","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"Option"},"2436":{"id":"/docs/server/depth-quantization-calibrator-40","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"Default"},"2437":{"id":"/docs/server/depth-quantization-calibrator-41","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"Meaning"},"2438":{"id":"/docs/server/depth-quantization-calibrator-42","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"`--config PATH`"},"2439":{"id":"/docs/server/depth-quantization-calibrator-43","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"`config/dev/live.yaml`"},"2440":{"id":"/docs/server/depth-quantization-calibrator-44","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"Live YAML config. The file must exist."},"2441":{"id":"/docs/server/depth-quantization-calibrator-45","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"`--output PATH`"},"2442":{"id":"/docs/server/depth-quantization-calibrator-46","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"`encoding.depth.quantization_profile_path`"},"2443":{"id":"/docs/server/depth-quantization-calibrator-47","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"Where to write the profile JSON. Parent folders are created."},"2444":{"id":"/docs/server/depth-quantization-calibrator-48","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"`--duration-s N`"},"2445":{"id":"/docs/server/depth-quantization-calibrator-49","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content":"`setup.maximum_duration_seconds`"},"2446":{"id":"/docs/server/depth-quantization-calibrator-50","page_id":"/docs/server/depth-quantization-calibrator","tags":[],"type":"text","url":"/docs/server/depth-quantization-calibrator#options","content