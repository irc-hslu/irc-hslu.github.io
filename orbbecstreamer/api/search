ion"},"2898":{"id":"/docs/server-18","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#status","content":"Works on synthetic input; not yet validated with a printed board"},"2899":{"id":"/docs/server-19","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#status","content":"Local debug recording, terminal telemetry"},"2900":{"id":"/docs/server-20","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#status","content":"Works"},"2901":{"id":"/docs/server-21","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#status","content":"WebTransport serving to browsers"},"2902":{"id":"/docs/server-22","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#status","content":"Not available yet"},"2903":{"id":"/docs/server-23","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#where-to-start","content":"Check the requirements: Ubuntu 26.04, an NVIDIA GPU with\nNVENC (tested on an RTX 4090), CUDA 13, TensorRT, the Orbbec SDK 2.8.7, and\nOrbbec cameras."},"2904":{"id":"/docs/server-24","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#where-to-start","content":"Install the system packages, SDKs and vcpkg."},"2905":{"id":"/docs/server-25","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#where-to-start","content":"Build with the CMake presets and run the tests."},"2906":{"id":"/docs/server-26","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#where-to-start","content":"Write a configuration for your cameras and choose a\nstream layout."},"2907":{"id":"/docs/server-27","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#where-to-start","content":"Run the server and read the telemetry."},"2908":{"id":"/docs/server-28","page_id":"/docs/server","tags":[],"type":"text","url":"/docs/server#how-it-works","content":"Architecture: the pipeline, its threads and queues."},"2909":{"id":"/docs/server-29","page_id":"/docs/se