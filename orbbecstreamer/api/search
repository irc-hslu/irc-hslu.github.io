d":"/docs/client/dev-build-30","page_id":"/docs/client/dev-build","tags":[],"type":"text","url":"/docs/client/dev-build#dev-check-pages","content":"The dev server also serves check pages from `client/dev/`. They are\n**never** part of the production build. Each runs a real part of the\nclient in the browser and writes a report."},"188":{"id":"/docs/client/dev-build-31","page_id":"/docs/client/dev-build","tags":[],"type":"text","url":"/docs/client/dev-build#dev-check-pages","content":"Page"},"189":{"id":"/docs/client/dev-build-32","page_id":"/docs/client/dev-build","tags":[],"type":"text","url":"/docs/client/dev-build#dev-check-pages","content":"What it checks"},"190":{"id":"/docs/client/dev-build-33","page_id":"/docs/client/dev-build","tags":[],"type":"text","url":"/docs/client/dev-build#dev-check-pages","content":"http\\://localhost:5173/dev/decode-check.html"},"191":{"id":"/docs/client/dev-build-34","page_id":"/docs/client/dev-build","tags":[],"type":"text","url":"/docs/client/dev-build#dev-check-pages","content":"WebCodecs HEVC support and real decoding of a recording"},"192":{"id":"/docs/client/dev-build-35","page_id":"/docs/client/dev-build","tags":[],"type":"text","url":"/docs/client/dev-build#dev-check-pages","content":"http\\://localhost:5173/dev/render-check.html"},"193":{"id":"/docs/client/dev-build-36","page_id":"/docs/client/dev-build","tags":[],"type":"text","url":"/docs/client/dev-build#dev-check-pages","content":"The renderer, with a synthetic two-camera scene"},"194":{"id":"/docs/client/dev-build-37","page_id":"/docs/client/dev-build","tags":[],"type":"text","url":"/docs/client/dev-build#dev-check-pages","content":"http\\://localhost:5173/dev/wiring-check.html"},"195":{"id":"/docs/client/dev-build-38","page_id":"/docs/client/dev-build","tags":[],"type":"text","url":"/docs/client/dev-build#dev-check-pages","content":"The full client stack with two recordings side by side and a synthetic decoder"},"196":{"id":"/docs/client/dev-build-39","page_id":"/doc