er/latency-179","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"Parameters:"},"451":{"id":"/docs/client/developer/latency-180","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"`autorun=samples` (or `autorun=bundled`) starts with the reference\nrecordings;"},"452":{"id":"/docs/client/developer/latency-181","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"`color=<url>` and `depth=<url>` replace the recording URLs;"},"453":{"id":"/docs/client/developer/latency-182","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"without `autorun`, you can pick files."},"454":{"id":"/docs/client/developer/latency-183","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"Report: `window.__decodeCheckReport`."},"455":{"id":"/docs/client/developer/latency-184","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"Needs a browser that can decode HEVC. Headless Chromium without it ends\n`failed` with \"no HEVC configuration is supported\"."},"456":{"id":"/docs/client/developer/latency-185","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"**Render check**"},"457":{"id":"/docs/client/developer/latency-186","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"URL: `http://localhost:5173/dev/render-check.html?autorun=1&engine=webgl2`"},"458":{"id":"/docs/client/developer/latency-187","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"What it checks: the renderer and feed, using a synthetic two-camera bundle\n(generated depth codes and colour, no HEVC, no reference files needed)."},"459":{"id":"/docs/client/developer/latency-188","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"Parameters:"},"460":{"id":"/docs/client/developer/latency-189","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"`frames=N` (default 90);"},"461":{"id":"/docs/client/developer/latency-190","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"`debug=1` draws below-range codes blue and above-range codes red;"},"462":{"id":"/docs/client/developer/latency-191","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"`engine=webgl2` or `engine=webgpu`;"},"463":{"id":"/docs/client/developer/latency-192","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"`readback=1` paints the read-back frame into an overlay after the run."},"464":{"id":"/docs/client/developer/latency-193","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"Report: `window.__renderCheckReport`."},"465":{"id":"/docs/client/developer/latency-194","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"**Wiring check**"},"466":{"id":"/docs/client/developer/latency-195","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"URL: `http://localhost:5173/dev/wiring-check.html?autorun=1&engine=webgl2`"},"467":{"id":"/docs/client/developer/latency-196","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"What it checks: the full composition, with two recordings side by side\nthrough the connection manager, pipelines and one shared renderer, using\nthe synthetic decoder. `done` needs both servers connected, pairs uploaded,\nand drawn points in both halves of the read-back."},"468":{"id":"/docs/client/developer/latency-197","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"Parameters: `engine=webgl2` or `engine=webgpu`, and `readback=1`."},"469":{"id":"/docs/client/developer/latency-198","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"Needs the reference recordings."},"470":{"id":"/docs/client/developer/latency-199","page_id":"/docs/client/developer/latency","tags":[],"type":"text","url":"/docs/client/developer/latency#other-dev-check-pages","content":"Report: `window.__wiringCheckReport`."},"471":{"id":"/docs/client/developer/mock-server","page_id":"/docs/client/developer/mock-server","type":"page","content":"Mock server","breadcrumbs":["HSLU OrbbecStreamer","Client","Developer"],"tags":[],"url":"/docs/client/developer/mock-server"},"472":{"id":"/docs/client/developer/mock-server-0","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server","content":"A deterministic in-process capture server for client tests and dev pages."},"473":{"id":"/docs/client/developer/mock-server-1","page_id":"/docs/client/developer/mock-server","type":"heading","tags":[],"url":"/docs/client/developer/mock-server#what-it-is","content":"What it is"},"474":{"id":"/docs/client/developer/mock-server-2","page_id":"/docs/client/developer/mock-server","type":"heading","tags":[],"url":"/docs/client/developer/mock-server#how-to-use-it","content":"How to use it"},"475":{"id":"/docs/client/developer/mock-server-3","page_id":"/docs/client/developer/mock-server","type":"heading","tags":[],"url":"/docs/client/developer/mock-server#expected-result","content":"Expected result"},"476":{"id":"/docs/client/developer/mock-server-4","page_id":"/docs/client/developer/mock-server","type":"heading","tags":[],"url":"/docs/client/developer/mock-server#troubleshooting","content":"Troubleshooting"},"477":{"id":"/docs/client/developer/mock-server-5","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#what-it-is","content":"The mock server (`client/src/media/playback/mockServer.ts`) simulates one\nOrbbecStreamer capture server inside the client, on the same byte-level\nseam a WebTransport session uses. Real `ServerConnection`s connect to it,\nso the following run exactly as against a real server, with no network and\nno hardware:"},"478":{"id":"/docs/client/developer/mock-server-6","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#what-it-is","content":"the handshake and snapshots;"},"479":{"id":"/docs/client/developer/mock-server-7","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#what-it-is","content":"the setup lock, calibration and placement commits;"},"480":{"id":"/docs/client/developer/mock-server-8","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#what-it-is","content":"shared-update filtering;"},"481":{"id":"/docs/client/developer/mock-server-9","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#what-it-is","content":"media streams."},"482":{"id":"/docs/client/developer/mock-server-10","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#what-it-is","content":"How it behaves:"},"483":{"id":"/docs/client/developer/mock-server-11","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#what-it-is","content":"**Sessions:** one `MockServer` holds one server state. Every client that\nopens it gets its own session, and a reconnect opens a new session."},"484":{"id":"/docs/client/developer/mock-server-12","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#what-it-is","content":"**Time:** it comes only from the scheduler you pass in. With a\n`ManualScheduler`, every run is deterministic."},"485":{"id":"/docs/client/developer/mock-server-13","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#what-it-is","content":"**Media:** it comes from a recording (`.hevc` colour and depth files plus\na manifest), the same format as recording playback. Without a recording\nthe server has no media."},"486":{"id":"/docs/client/developer/mock-server-14","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#what-it-is","content":"**Open contract questions:** where the protocol contract is still open,\nthe mock follows the client's pending change requests (0007, 0008, 0009,\n0012, 0014), listed at the top of `mockServer.ts`. A real server may\nbehave differently until those are decided."},"487":{"id":"/docs/client/developer/mock-server-15","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#how-to-use-it","content":"In a test:"},"488":{"id":"/docs/client/developer/mock-server-16","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#how-to-use-it","content":"With media, create it from a recording:"},"489":{"id":"/docs/client/developer/mock-server-17","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#how-to-use-it","content":"In a dev page or in composition code, add it as a source:"},"490":{"id":"/docs/client/developer/mock-server-18","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#how-to-use-it","content":"Create the mock on the same scheduler as the connection manager. Each\nconnection manager that uses the same mock is another client of the same\nserver. Two entries in one manager reach the same server id, and the\nsecond one reports a conflict."},"491":{"id":"/docs/client/developer/mock-server-19","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#how-to-use-it","content":"Useful controls:"},"492":{"id":"/docs/client/developer/mock-server-20","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#how-to-use-it","content":"**Scenario:** `setStreaming`, `setBundleAvailability`, and calibration\nscripts passed in `createMockServer({ calibration })`: duration,\nprogress interval, accepted or failed, new camera poses or a new depth\nprofile, and a depth-code histogram per progress message\n(`depthHistogram`; `syntheticDepthHistogram` in `src/dev/devMock.ts`\nis a ready-made one). The shell's \"Add mock server\" scripts a 6 s\ndepth-quantization run with that histogram."},"493":{"id":"/docs/client/developer/mock-server-21","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#how-to-use-it","content":"**Faults:** `dropSession`, `closeSession`, `delaySession`,\n`stallSession` / `resumeSession`, `sendMalformed`, `skipRevisions`,\n`sendStaleRevision`, `refuseSnapshots`, `expireLease`."},"494":{"id":"/docs/client/developer/mock-server-22","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#how-to-use-it","content":"**Inspection:** `sessions()`, `sessionOf(clientId)`, `lockHolder()`,\n`snapshot()`, `metadataRevision`, `session.requestCounts`,\n`session.mediaStats(bundleId)`."},"495":{"id":"/docs/client/developer/mock-server-23","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#expected-result","content":"A client connects and receives a snapshot. With a recording, it receives\npaired colour and depth frames after it subscribes."},"496":{"id":"/docs/client/developer/mock-server-24","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#expected-result","content":"The setup lock is exclusive. It stays held while its owner heartbeats\nevery 5 s, and it expires 15 s after the last heartbeat."},"497":{"id":"/docs/client/developer/mock-server-25","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#expected-result","content":"A calibration commit or placement commit reaches every client as a\nrevision notice. Clients that opted in to shared updates, and the client\nthat made the change, also receive the placement or calibration result\nitself. A placement commit restarts the media streams, which resume with\na keyframe."},"498":{"id":"/docs/client/developer/mock-server-26","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#expected-result","content":"Each fault drives the client's recovery path: a resync, a reconnect, or\n`resync-failed` followed by a reconnect."},"499":{"id":"/docs/client/developer/mock-server-27","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#expected-result","content":"In the browser, with the dev server running (`npm run dev` in `client/`):"},"500":{"id":"/docs/client/developer/mock-server-28","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#expected-result","content":"**The app:** the side panel of http\\://localhost:5173/\nhas a \"Dev: mock server\" section. **Add mock server** adds a mock as a\nnew server card, with the source `mock mock://dev-mock-…`."},"501":{"id":"/docs/client/developer/mock-server-29","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#expected-result","content":"It serves the reference recordings when `client/reference/hevc-web/`\nexists (the status line says `reference recording`), and is\nsnapshot-only otherwise (`snapshot only, no media`)."},"502":{"id":"/docs/client/developer/mock-server-30","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#expected-result","content":"The section exists only in the dev server. A production build\n(`npm run build`) contains no mock code."},"503":{"id":"/docs/client/developer/mock-server-31","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#expected-result","content":"**Two clients of one mock:** the\ncards check,\nsetup check and\nplacement check pages."},"504":{"id":"/docs/client/developer/mock-server-32","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#troubleshooting","content":"**`createMockServer` returns `ok: false`:** read `issues`. It needs a\nsnapshot or a recording, the snapshot must be valid, and the snapshot's\nlock must be free."},"505":{"id":"/docs/client/developer/mock-server-33","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#troubleshooting","content":"**Nothing happens in a test:** a `ManualScheduler` only moves when you\ncall `advanceBy` or `advanceTo`, and replies need a few microtask turns\nto settle."},"506":{"id":"/docs/client/developer/mock-server-34","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#troubleshooting","content":"**No media:** check all of the following."},"507":{"id":"/docs/client/developer/mock-server-35","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#troubleshooting","content":"The mock needs a recording."},"508":{"id":"/docs/client/developer/mock-server-36","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#troubleshooting","content":"The client must subscribe, or list the bundle in `preferredBundleIds`."},"509":{"id":"/docs/client/developer/mock-server-37","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#troubleshooting","content":"The server must be `streaming`, with the bundle available."},"510":{"id":"/docs/client/developer/mock-server-38","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#troubleshooting","content":"If the snapshot has `autocalibrate` set, media is held until\ncamera-pose is committed."},"511":{"id":"/docs/client/developer/mock-server-39","page_id":"/docs/client/developer/mock-server","tags":[],"type":"text","url":"/docs/client/developer/mock-server#troubleshooting","content":"**`skipRevisions` does not make the client resync:** a forward revision\ngap is not treated as an error until change request 0007 is decided. Use\n`sendStaleRevision` to exercise the resync path."},"512":{"id":"/docs/client/developer/placement-check","page_id":"/docs/client/developer/placement-check","type":"page","content":"Placement check","breadcrumbs":["HSLU OrbbecStreamer","Client","Developer"],"tags":[],"url":"/docs/client/developer/placement-check"},"513":{"id":"/docs/client/developer/placement-check-0","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check","content":"A dev page that drives placement editing and world anchors through a scripted scenario with two clients of one mock server."},"514":{"id":"/docs/client/developer/placement-check-1","page_id":"/docs/client/developer/placement-check","type":"heading","tags":[],"url":"/docs/client/developer/placement-check#what-it-is","content":"What it is"},"515":{"id":"/docs/client/developer/placement-check-2","page_id":"/docs/client/developer/placement-check","type":"heading","tags":[],"url":"/docs/client/developer/placement-check#how-to-use-it","content":"How to use it"},"516":{"id":"/docs/client/developer/placement-check-3","page_id":"/docs/client/developer/placement-check","type":"heading","tags":[],"url":"/docs/client/developer/placement-check#expected-result","content":"Expected result"},"517":{"id":"/docs/client/developer/placement-check-4","page_id":"/docs/client/developer/placement-check","type":"heading","tags":[],"url":"/docs/client/developer/placement-check#troubleshooting","content":"Troubleshooting"},"518":{"id":"/docs/client/developer/placement-check-5","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#what-it-is","content":"The placement check (`client/dev/placement-check.html`, code in\n`client/src/dev/placementCheck.tsx` and `client/src/dev/placementScenario.ts`)\nis a dev-only page for placement editing\nand world anchors.\nIt is never part of the production build."},"519":{"id":"/docs/client/developer/placement-check-6","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#what-it-is","content":"It runs two clients of one mock server:"},"520":{"id":"/docs/client/developer/placement-check-7","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#what-it-is","content":"**Client A** has a 3D view (WebGPU or WebGL2; none if neither starts)\nand decodes with WebCodecs when the browser can."},"521":{"id":"/docs/client/developer/placement-check-8","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#what-it-is","content":"**Client B** has no 3D view."},"522":{"id":"/docs/client/developer/placement-check-9","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#what-it-is","content":"Both use the app's own setup workspace, server cards and World anchors\nsection. The mock serves the reference recordings when the dev server has\nthem (`client/reference/hevc-web/`), otherwise it is snapshot-only."},"523":{"id":"/docs/client/developer/placement-check-10","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#what-it-is","content":"\"Where a client draws the server\" is read from its renderer, so the\nchecks work with or without media. With media and HEVC decoding, A's\ncloud visibly moves in the 3D view."},"524":{"id":"/docs/client/developer/placement-check-11","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"Start the dev server in `client/`:"},"525":{"id":"/docs/client/developer/placement-check-12","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"Open this URL:"},"526":{"id":"/docs/client/developer/placement-check-13","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"Without `autorun=1`, press **Run scenario** once the columns appear."},"527":{"id":"/docs/client/developer/placement-check-14","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"The scenario, in order:"},"528":{"id":"/docs/client/developer/placement-check-15","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"Both clients connect at the same placement revision."},"529":{"id":"/docs/client/developer/placement-check-16","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"A enters setup. The Placement section shows the server placement, and\n**Edit placement** is available."},"530":{"id":"/docs/client/developer/placement-check-17","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"A starts a draft and types a pose (x 0.5 m, z 1 m, yaw 30°). The draft\nis dirty, A draws the server at the draft, B does not move, and the mock\nstill has the old revision after a wait."},"531":{"id":"/docs/client/developer/placement-check-18","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"A selects **Commit placement (expected revision 1)**. A and B get\nrevision 2 and both draw the committed placement; A's draft is cleared."},"532":{"id":"/docs/client/developer/placement-check-19","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"B starts its own draft without the lock. A commits another edit\n(revision 3) and leaves setup. B enters setup: its draft is kept,\nmarked stale, and **Commit placement** is unavailable with the stale\nreason. Pressing it anyway sends nothing."},"533":{"id":"/docs/client/developer/placement-check-20","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"B selects **Rebase on server placement (revision 3)**, which keeps its\npose, and commits. A and B get revision 4 and draw B's pose."},"534":{"id":"/docs/client/developer/placement-check-21","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"A moves the world anchor (x 2 m, yaw 90°). Only A's drawing moves; B\nand every revision stay the same. A scaled anchor pose is refused.\n**Reset to identity** restores A's drawing."},"535":{"id":"/docs/client/developer/placement-check-22","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#how-to-use-it","content":"B leaves setup, and the lock is free."},"536":{"id":"/docs/client/developer/placement-check-23","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#expected-result","content":"`body[data-state]` ends as `done`, and the log ends with\n`verdict: 8 steps passed`."},"537":{"id":"/docs/client/developer/placement-check-24","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#expected-result","content":"`window.__placementCheckReport` holds the report: `state`, `media`,\n`renderer`, `steps[]` (`name`, `ok`, `detail`), `log`, `errors` and\n`verdict`. The same JSON is in the collapsed \"report JSON\" panel."},"538":{"id":"/docs/client/developer/placement-check-25","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#expected-result","content":"Without HEVC decoding, the log starts with two\n`Subscribe to bundle-cam0 failed: not-decode-compatible` warnings.\nThey are expected: the clients cannot decode the streams, so no frames\nare drawn, but the placement checks still pass."},"539":{"id":"/docs/client/developer/placement-check-26","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#expected-result","content":"Recorded run by the client team's UI engineer on 2026-09-28 (Linux,\nChromium 153.0.8010.36 snap, headless), with:"},"540":{"id":"/docs/client/developer/placement-check-27","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#expected-result","content":"(dev server on port 5193 for that run). Result: `data-state=\"done\"`,\n`verdict: 8 steps passed`, `errors` empty. A drew with WebGL2\n(SwiftShader), the mock used the reference recording, and this browser\nhad no HEVC decoding, so the checks ran on the renderer's geometry and\nno frames were drawn. The page drives the editor's controllers, not the\nmouse or keyboard, so it does not exercise dragging the 3D handle. That\nwas verified separately on 2026-09-28 with real mouse drags in headless\nChromium 153 (SwiftShader, WebGL2 and WebGPU); see\nPlacement editing."},"541":{"id":"/docs/client/developer/placement-check-28","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#expected-result","content":"The same scenario runs in Node on a simulated clock as part of `npm test`\n(`client/src/tests/placementEditor.test.ts`)."},"542":{"id":"/docs/client/developer/placement-check-29","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#troubleshooting","content":"**`failed` with `timed out waiting for: …`:** the named step did not\nreach the expected state within 8 s. The text after it shows the\nplacement revision A, B and the mock had at that moment."},"543":{"id":"/docs/client/developer/placement-check-30","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#troubleshooting","content":"**`failed` with `watchdog: not done after 90 s`:** the run hung. Reload\nthe page and check the browser console."},"544":{"id":"/docs/client/developer/placement-check-31","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#troubleshooting","content":"**The 3D view stays empty:** the browser has no WebGPU or WebGL2, or no\nHEVC decoding. The scenario still passes; the report's `renderer` field\nsays which case applies."},"545":{"id":"/docs/client/developer/placement-check-32","page_id":"/docs/client/developer/placement-check","tags":[],"type":"text","url":"/docs/client/developer/placement-check#troubleshooting","content":"**The run fails after you clicked controls on the page:** the scenario\nexpects to drive the workspaces itself. Reload and run it without\nclicking."},"546":{"id":"/docs/client/developer/setup-check","page_id":"/docs/client/developer/setup-check","type":"page","content":"Setup check","breadcrumbs":["HSLU OrbbecStreamer","Client","Developer"],"tags":[],"url":"/docs/client/developer/setup-check"},"547":{"id":"/docs/client/developer/setup-check-0","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check","content":"A dev page that drives the setup workspace through a scripted depth-quantization calibration against one mock server, with a second client watching."},"548":{"id":"/docs/client/developer/setup-check-1","page_id":"/docs/client/developer/setup-check","type":"heading","tags":[],"url":"/docs/client/developer/setup-check#what-it-is","content":"What it is"},"549":{"id":"/docs/client/developer/setup-check-2","page_id":"/docs/client/developer/setup-check","type":"heading","tags":[],"url":"/docs/client/developer/setup-check#how-to-use-it","content":"How to use it"},"550":{"id":"/docs/client/developer/setup-check-3","page_id":"/docs/client/developer/setup-check","type":"heading","tags":[],"url":"/docs/client/developer/setup-check#expected-result","content":"Expected result"},"551":{"id":"/docs/client/developer/setup-check-4","page_id":"/docs/client/developer/setup-check","type":"heading","tags":[],"url":"/docs/client/developer/setup-check#troubleshooting","content":"Troubleshooting"},"552":{"id":"/docs/client/developer/setup-check-5","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#what-it-is","content":"The setup check (`client/dev/setup-check.html`, code in\n`client/src/dev/setupCheck.tsx` and `client/src/dev/setupScenario.ts`) is\na dev-only page for the setup workspace\nand its calibration sections. It is never part\nof the production build."},"553":{"id":"/docs/client/developer/setup-check-6","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#what-it-is","content":"It runs two clients of one mock server:"},"554":{"id":"/docs/client/developer/setup-check-7","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#what-it-is","content":"**Client A** uses the app's own setup workspace, through the same\ncontroller the workspace's buttons use."},"555":{"id":"/docs/client/developer/setup-check-8","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#what-it-is","content":"**Client B** shows the app's server cards. It holds the lock in one\nstep and shows which revision is in force."},"556":{"id":"/docs/client/developer/setup-check-9","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#what-it-is","content":"The mock is snapshot-only (no media, nothing drawn in 3D). Its\ndepth-quantization calibration is scripted: progress every 250 ms with a\nsynthetic depth-code histogram, and an accepted result after 1.5 s."},"557":{"id":"/docs/client/developer/setup-check-10","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"Start the dev server in `client/`:"},"558":{"id":"/docs/client/developer/setup-check-11","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"Open this URL:"},"559":{"id":"/docs/client/developer/setup-check-12","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"Without `autorun=1`, press **Run scenario**. **Expire the lease** makes\nthe mock server expire the current lock at any time."},"560":{"id":"/docs/client/developer/setup-check-13","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"The scenario, in order:"},"561":{"id":"/docs/client/developer/setup-check-14","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"Both clients connect, and **Set up** is available on A's card."},"562":{"id":"/docs/client/developer/setup-check-15","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"A enters setup: A holds the lock with a countdown, B shows it held\nby A."},"563":{"id":"/docs/client/developer/setup-check-16","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"A starts a depth-quantization run. Progress with a histogram appears,\nthen `Result ready: revision 2, not in force until committed.` B still\nshows revision 1."},"564":{"id":"/docs/client/developer/setup-check-17","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"A commits. A and B show `valid, revision 2`."},"565":{"id":"/docs/client/developer/setup-check-18","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"A starts another run and cancels it. The revision stays at 2, and the\nmock holds no result."},"566":{"id":"/docs/client/developer/setup-check-19","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"A starts a third run, and the mock expires the lease in the middle of\nit. A shows `Forced out of setup. The server ended the setup lease.`\nand `Nothing was committed.` The revision stays at 2."},"567":{"id":"/docs/client/developer/setup-check-20","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"B acquires the lock, and A enters setup again. A shows\n`Could not enter setup. The setup lock is held by Client B.` B then\nreleases the lock."},"568":{"id":"/docs/client/developer/setup-check-21","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#how-to-use-it","content":"A enters setup again and leaves: `Left setup: the setup lock was released.`,\nand both clients show the lock free."},"569":{"id":"/docs/client/developer/setup-check-22","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#expected-result","content":"`body[data-state]` ends as `done`, and the log ends with\n`verdict: 8 steps passed`."},"570":{"id":"/docs/client/developer/setup-check-23","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#expected-result","content":"`window.__setupCheckReport` holds the report: `state`, `steps[]`\n(`name`, `ok`, `detail`), `log`, `errors` and `verdict`. The same JSON is\nin the collapsed \"report JSON\" panel."},"571":{"id":"/docs/client/developer/setup-check-24","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#expected-result","content":"The log shows two `Subscribe to bundle-cam0 failed: not-decode-compatible`\nwarnings at the start. They are expected: the page has no decoders."},"572":{"id":"/docs/client/developer/setup-check-25","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#expected-result","content":"Recorded run, 2026-09-28, headless snap Chromium 153 on Linux (the UI\nengineer): `done`, 8 of 8 steps, no errors."},"573":{"id":"/docs/client/developer/setup-check-26","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#expected-result","content":"The same scenario runs in Node on a simulated clock as part of `npm test`\n(`client/src/tests/setupWorkspace.test.ts`)."},"574":{"id":"/docs/client/developer/setup-check-27","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#troubleshooting","content":"**`failed` with `timed out waiting for: …`:** the named step did not\nreach the expected state within 8 s. The text after it shows A's\nsession line, lock line and depth-quantization state at that moment."},"575":{"id":"/docs/client/developer/setup-check-28","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#troubleshooting","content":"**`failed` with `watchdog: not done after 60 s`:** the run hung. Reload\nthe page and check the browser console."},"576":{"id":"/docs/client/developer/setup-check-29","page_id":"/docs/client/developer/setup-check","tags":[],"type":"text","url":"/docs/client/developer/setup-check#troubleshooting","content":"**The run fails after you pressed Expire the lease by hand:** expected;\nthe scenario expects to hold the lock in most steps. Reload and run it\nwithout pressing buttons."},"577":{"id":"/docs/client/getting-started-notes","page_id":"/docs/client/getting-started-notes","type":"page","content":"Getting started notes","breadcrumbs":["HSLU OrbbecStreamer","Client"],"tags":[],"url":"/docs/client/getting-started-notes"},"578":{"id":"/docs/client/getting-started-notes-0","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes","content":"Verified facts about the client for the docs team's Getting Started guide."},"579":{"id":"/docs/client/getting-started-notes-1","page_id":"/docs/client/getting-started-notes","type":"heading","tags":[],"url":"/docs/client/getting-started-notes#what-it-is","content":"What it is"},"580":{"id":"/docs/client/getting-started-notes-2","page_id":"/docs/client/getting-started-notes","type":"heading","tags":[],"url":"/docs/client/getting-started-notes#requirements","content":"Requirements"},"581":{"id":"/docs/client/getting-started-notes-3","page_id":"/docs/client/getting-started-notes","type":"heading","tags":[],"url":"/docs/client/getting-started-notes#install-and-run","content":"Install and run"},"582":{"id":"/docs/client/getting-started-notes-4","page_id":"/docs/client/getting-started-notes","type":"heading","tags":[],"url":"/docs/client/getting-started-notes#environment-variables","content":"Environment variables"},"583":{"id":"/docs/client/getting-started-notes-5","page_id":"/docs/client/getting-started-notes","type":"heading","tags":[],"url":"/docs/client/getting-started-notes#ports","content":"Ports"},"584":{"id":"/docs/client/getting-started-notes-6","page_id":"/docs/client/getting-started-notes","type":"heading","tags":[],"url":"/docs/client/getting-started-notes#reaching-a-server","content":"Reaching a server"},"585":{"id":"/docs/client/getting-started-notes-7","page_id":"/docs/client/getting-started-notes","type":"heading","tags":[],"url":"/docs/client/getting-started-notes#not-yet-available","content":"Not yet available"},"586":{"id":"/docs/client/getting-started-notes-8","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#what-it-is","content":"These are notes for the docs team, not a tutorial. Each fact below was\nchecked against `client/package.json`, `client/vite.config.ts`,\n`client/index.html` and the client source on 2026-09-28. The user-facing\npages are Run the dev build,\nBrowser requirements and\nAdd a server."},"587":{"id":"/docs/client/getting-started-notes-9","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"**Node.js:**"},"588":{"id":"/docs/client/getting-started-notes-10","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"`client/package.json` has no `engines` field, and the repository has no\n`.nvmrc`."},"589":{"id":"/docs/client/getting-started-notes-11","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"The client was built and tested with Node 24.18.0."},"590":{"id":"/docs/client/getting-started-notes-12","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"`@types/node` is `^22`."},"591":{"id":"/docs/client/getting-started-notes-13","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"**npm:**"},"592":{"id":"/docs/client/getting-started-notes-14","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"There is a `client/package-lock.json`, so install with `npm ci`."},"593":{"id":"/docs/client/getting-started-notes-15","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"**Browser:**"},"594":{"id":"/docs/client/getting-started-notes-16","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"No particular browser is verified yet. The browser needs the\nfollowing:"},"595":{"id":"/docs/client/getting-started-notes-17","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"**WebTransport** for live servers."},"596":{"id":"/docs/client/getting-started-notes-18","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"**WebCodecs** with HEVC Main (colour) and HEVC Main10 (depth) for\npoint clouds."},"597":{"id":"/docs/client/getting-started-notes-19","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"**WebGPU or WebGL2** for drawing."},"598":{"id":"/docs/client/getting-started-notes-20","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"Without decoding or rendering, the client still connects as a control\nand setup client."},"599":{"id":"/docs/client/getting-started-notes-21","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#requirements","content":"Real HEVC decoding has not been verified in any browser yet. Details are\nin Browser requirements."},"600":{"id":"/docs/client/getting-started-notes-22","page_id":"/docs/client/getting-started-notes","tags":[],"type":"text","url":"/docs/client/getting-started-notes#install-and-run","content":"Then open htt