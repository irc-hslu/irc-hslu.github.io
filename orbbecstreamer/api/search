2618":{"id":"/docs/server/encoding-106","page_id":"/docs/server/encoding","tags":[],"type":"text","url":"/docs/server/encoding#what-you-can-configure","content":"Depth bitrate per camera"},"2619":{"id":"/docs/server/encoding-107","page_id":"/docs/server/encoding","tags":[],"type":"text","url":"/docs/server/encoding#what-you-can-configure","content":"`depth.minimum_depth_mm`, `depth.maximum_depth_mm`, `depth.quantization_profile_path`"},"2620":{"id":"/docs/server/encoding-108","page_id":"/docs/server/encoding","tags":[],"type":"text","url":"/docs/server/encoding#what-you-can-configure","content":"`500`, `5000`, `config/dev/depth-quantization.json`"},"2621":{"id":"/docs/server/encoding-109","page_id":"/docs/server/encoding","tags":[],"type":"text","url":"/docs/server/encoding#what-you-can-configure","content":"Depth code range and LUT"},"2622":{"id":"/docs/server/encoding-110","page_id":"/docs/server/encoding","tags":[],"type":"text","url":"/docs/server/encoding#what-you-can-configure","content":"The encoder frame rate is `streams.depth.fps`; colour and depth fps must be\nequal. Enlarging `queue_capacity` does not make encoding faster; it only adds\nlatency after a stall."},"2623":{"id":"/docs/server/encoding-111","page_id":"/docs/server/encoding","tags":[],"type":"text","url":"/docs/server/encoding#measured-timing","content":"From the 2026-09-26 baseline (two Femto Bolts, RTX 4090,\n`dev-relwithdebinfo`, 15 fps, `concatenated_batch`, 1280 × 576 surfaces):"},"2624":{"id":"/docs/server/encoding-112","page_id":"/docs/server/encoding","tags":[],"type":"text","url":"/docs/server/encoding#measured-timing","content":"Metric"},"2625":{"id":"/docs/server/encoding-113","page_id":"/docs/server/encoding","tags":[],"type":"text","url":"/docs/server/encoding#measured-timing","content":"p50"},"2626":{"id":"/docs/server/encoding-114","page_id":"/docs/server/encoding","tags":[],"type":"text","url":"/docs/server/encoding#measured-timing","content":"p99"},"2627":{"id":"/docs/server/enc