age_id":"/docs/server/requirements","type":"heading","tags":[],"url":"/docs/server/requirements#operating-system-and-disk","content":"Operating system and disk"},"3154":{"id":"/docs/server/requirements-7","page_id":"/docs/server/requirements","type":"heading","tags":[],"url":"/docs/server/requirements#check-your-machine","content":"Check your machine"},"3155":{"id":"/docs/server/requirements-8","page_id":"/docs/server/requirements","type":"heading","tags":[],"url":"/docs/server/requirements#expected-result","content":"Expected result"},"3156":{"id":"/docs/server/requirements-9","page_id":"/docs/server/requirements","type":"heading","tags":[],"url":"/docs/server/requirements#troubleshooting","content":"Troubleshooting"},"3157":{"id":"/docs/server/requirements-10","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements","content":"The server runs on one Linux machine with an NVIDIA GPU and one or more Orbbec\ncameras connected over USB. This page lists what that machine needs and how to\ncheck each item. The next step is Install."},"3158":{"id":"/docs/server/requirements-11","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"Only one configuration has been tested. Other versions may work but are not\ntested."},"3159":{"id":"/docs/server/requirements-12","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"Component"},"3160":{"id":"/docs/server/requirements-13","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"Tested version"},"3161":{"id":"/docs/server/requirements-14","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"OS"},"3162":{"id":"/docs/server/requirements-15","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"Ubuntu 26.04.1 LTS (x86_64)"},"3163":{"id":"/docs/server/requirements-16","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"GPU"},"3164":{"id":"/docs/server/requirements-17","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"NVIDIA GeForce RTX 4090 (compute capability 8.9)"},"3165":{"id":"/docs/server/requirements-18","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"NVIDIA driver"},"3166":{"id":"/docs/server/requirements-19","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"580.178.04"},"3167":{"id":"/docs/server/requirements-20","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"CUDA toolkit"},"3168":{"id":"/docs/server/requirements-21","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"13.3 (`nvcc` V13.3.73), at `/usr/local/cuda`"},"3169":{"id":"/docs/server/requirements-22","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"TensorRT"},"3170":{"id":"/docs/server/requirements-23","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"11.1.0.106 (`+cuda13.3` Debian packages)"},"3171":{"id":"/docs/server/requirements-24","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"NVENC headers"},"3172":{"id":"/docs/server/requirements-25","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"`ffnvcodec` 12.1 (package `libffmpeg-nvenc-dev`)"},"3173":{"id":"/docs/server/requirements-26","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"Orbbec SDK"},"3174":{"id":"/docs/server/requirements-27","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"2.8.7"},"3175":{"id":"/docs/server/requirements-28","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"Cameras"},"3176":{"id":"/docs/server/requirements-29","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"2 × Orbbec Femto Bolt, firmware 1.1.2, hardware-synchronised"},"3177":{"id":"/docs/server/requirements-30","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"Compiler"},"3178":{"id":"/docs/server/requirements-31","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"GCC 15.2 (`/usr/bin/gcc-15`, `/usr/bin/g++-15`)"},"3179":{"id":"/docs/server/requirements-32","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"CMake / Ninja"},"3180":{"id":"/docs/server/requirements-33","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"CMake 4.1.2 and 4.2.3, Ninja 1.13.2"},"3181":{"id":"/docs/server/requirements-34","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"Python"},"3182":{"id":"/docs/server/requirements-35","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tested-reference-machine","content":"3.12 or newer, only to build the RVM engine"},"3183":{"id":"/docs/server/requirements-36","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#gpu","content":"The server encodes colour with NVENC HEVC Main and depth with HEVC Main10, and\nruns its image processing in CUDA. The GPU's NVENC must support all of the\nfeatures below. `orbbec_streamer --nvenc-test` checks them and names any that\nare missing:"},"3184":{"id":"/docs/server/requirements-37","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#gpu","content":"HEVC codec with the Main and Main10 profiles"},"3185":{"id":"/docs/server/requirements-38","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#gpu","content":"NV12 and YUV420 10-bit input surfaces"},"3186":{"id":"/docs/server/requirements-39","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#gpu","content":"10-bit encoding"},"3187":{"id":"/docs/server/requirements-40","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#gpu","content":"the P1 preset"},"3188":{"id":"/docs/server/requirements-41","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#gpu","content":"In practice you need a GeForce, RTX or Quadro GPU from the Turing generation\n(compute capability 7.5) or newer: CUDA 13 does not support older GPUs.\nCompute GPUs without NVENC, such as the A100 and H100, do not work."},"3189":{"id":"/docs/server/requirements-42","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#gpu","content":"The CMake presets compile CUDA code for compute capability 8.9 (RTX 40\nseries) and include `compute_89` PTX, which newer GPUs compile at startup. On\na GPU below compute capability 8.9 the CUDA kernels fail to launch. Build for\nyour GPU with a user preset as described in\nBuild."},"3190":{"id":"/docs/server/requirements-43","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#nvidia-driver-and-cuda","content":"CUDA 13.x needs driver branch 580 or newer."},"3191":{"id":"/docs/server/requirements-44","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#nvidia-driver-and-cuda","content":"The build expects the toolkit at `/usr/local/cuda` (`nvcc` at\n`/usr/local/cuda/bin/nvcc`). NVIDIA's packages create this link."},"3192":{"id":"/docs/server/requirements-45","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tensorrt","content":"TensorRT is required to build the server. CMake stops with an error if it\ncannot find the TensorRT headers and `libnvinfer`, because every server binary\nlinks it."},"3193":{"id":"/docs/server/requirements-46","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tensorrt","content":"The Robust Video Matting (RVM) engine file that TensorRT runs is needed only\nwhen:"},"3194":{"id":"/docs/server/requirements-47","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tensorrt","content":"the live config uses `mask.backend: rvm`, or"},"3195":{"id":"/docs/server/requirements-48","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tensorrt","content":"you run the two RVM smoke tests."},"3196":{"id":"/docs/server/requirements-49","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#tensorrt","content":"`trtexec` (package `libnvinfer-bin`) is needed only to build that engine."},"3197":{"id":"/docs/server/requirements-50","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#cameras","content":"**Model.** The only tested camera is the Orbbec Femto Bolt. The code talks to\nthe Orbbec SDK, not to a specific model, but all cameras in one rig must be\nthe same model."},"3198":{"id":"/docs/server/requirements-51","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#cameras","content":"**USB.** Each camera needs a USB 3 (SuperSpeed, 5 Gbit/s) connection. In\n`lsusb -t` the camera interfaces should show `5000M`, not `480M`."},"3199":{"id":"/docs/server/requirements-52","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#cameras","content":"**Multi-camera sync.** With more than one camera, one camera is the\n`primary` and the others are `secondary`. The primary sends a hardware\ntrigger to the secondaries. You set the roles and delays in the live config\n(`cameras[].role` and the `sync` block, see\nConfiguration). This repository does not document the\nsync cabling. Wire the cameras as described in Orbbec's multi-camera\nsynchronisation guide for your camera model."},"3200":{"id":"/docs/server/requirements-53","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#operating-system-and-disk","content":"**OS.** Ubuntu 26.04 is the only tested OS. The presets hard-code\n`/usr/bin/gcc-15`, `/usr/bin/g++-15` and `/usr/local/cuda`."},"3201":{"id":"/docs/server/requirements-54","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#operating-system-and-disk","content":"**Disk.** One build directory with its vcpkg dependencies takes about 5 GB.\nThe vcpkg binary cache in `~/.cache/vcpkg` takes about another 4.5 GB."},"3202":{"id":"/docs/server/requirements-55","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#operating-system-and-disk","content":"**Display (optional).** The live preview window opens only when `DISPLAY` or\n`WAYLAND_DISPLAY` is set. Without a display, the server still runs and logs\nthat the preview is off."},"3203":{"id":"/docs/server/requirements-56","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#check-your-machine","content":"Run these commands:"},"3204":{"id":"/docs/server/requirements-57","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#expected-result","content":"On the reference machine the output is:"},"3205":{"id":"/docs/server/requirements-58","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#expected-result","content":"`2bc5` is Orbbec's USB vendor ID. You should see one line per camera. After you\nbuild the server, `./build/dev-debug/orbbec_streamer --nvenc-test` confirms\nthe GPU has every NVENC feature it needs (see Build)."},"3206":{"id":"/docs/server/requirements-59","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"Symptom"},"3207":{"id":"/docs/server/requirements-60","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"Cause and fix"},"3208":{"id":"/docs/server/requirements-61","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"`nvidia-smi: command not found`, or it cannot talk to the driver"},"3209":{"id":"/docs/server/requirements-62","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"No NVIDIA driver is loaded. Install one as described in Install, then reboot."},"3210":{"id":"/docs/server/requirements-63","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"Compute capability is below 7.5"},"3211":{"id":"/docs/server/requirements-64","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"CUDA 13 does not support this GPU. Use a newer GPU."},"3212":{"id":"/docs/server/requirements-65","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"`--nvenc-test` fails with `NVENC does not support the required color/depth encoding pipeline. Missing: ...`"},"3213":{"id":"/docs/server/requirements-66","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"This GPU's NVENC cannot encode the 10-bit depth stream. Use a GPU that has these features."},"3214":{"id":"/docs/server/requirements-67","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"`lsusb` shows no `2bc5` device"},"3215":{"id":"/docs/server/requirements-68","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"Check the cable and the port, and use a USB 3 port. Some USB-C cables carry only USB 2 or only power."},"3216":{"id":"/docs/server/requirements-69","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"`lsusb -t` shows the camera at `480M`"},"3217":{"id":"/docs/server/requirements-70","page_id":"/docs/server/requirements","tags":[],"type":"text","url":"/docs/server/requirements#troubleshooting","content":"The camera is running at USB 2 speed. Move it to a USB 3 port or use a USB 3 cable."},"3218":{"id":"/docs/server/running","page_id":"/docs/server/running","type":"page","content":"Run the server","breadcrumbs":["HSLU OrbbecStreamer","Server","Get started"],"tags":[],"url":"/docs/server/running"},"3219":{"id":"/docs/server/running-0","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running","content":"Start the live capture and encode pipeline, run the hardware checks, stop the server cleanly and fix common start-up failures."},"3220":{"id":"/docs/server/running-1","page_id":"/docs/server/running","type":"heading","tags":[],"url":"/docs/server/running#before-you-start","content":"Before you start"},"3221":{"id":"/docs/server/running-2","page_id":"/docs/server/running","type":"heading","tags":[],"url":"/docs/server/running#adapt-the-config-to-your-rig","content":"Adapt the config to your rig"},"3222":{"id":"/docs/server/running-3","page_id":"/docs/server/running","type":"heading","tags":[],"url":"/docs/server/running#check-the-hardware","content":"Check the hardware"},"3223":{"id":"/docs/server/running-4","page_id":"/docs/server/running","type":"heading","tags":[],"url":"/docs/server/running#command-line-reference","content":"Command-line reference"},"3224":{"id":"/docs/server/running-5","page_id":"/docs/server/running","type":"heading","tags":[],"url":"/docs/server/running#start-the-live-pipeline","content":"Start the live pipeline"},"3225":{"id":"/docs/server/running-6","page_id":"/docs/server/running","type":"heading","tags":[],"url":"/docs/server/running#expected-result","content":"Expected result"},"3226":{"id":"/docs/server/running-7","page_id":"/docs/server/running","type":"heading","tags":[],"url":"/docs/server/running#debug-recording-output","content":"Debug recording output"},"3227":{"id":"/docs/server/running-8","page_id":"/docs/server/running","type":"heading","tags":[],"url":"/docs/server/running#stop-the-server","content":"Stop the server"},"3228":{"id":"/docs/server/running-9","page_id":"/docs/server/running","type":"heading","tags":[],"url":"/docs/server/running#troubleshooting","content":"Troubleshooting"},"3229":{"id":"/docs/server/running-10","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running","content":"`orbbec_streamer` is one binary with several modes. `--live` runs the full\npipeline: capture from the configured Orbbec cameras, GPU processing, NVENC\nHEVC encoding, optional debug recording and terminal telemetry. The other\nflags are checks for the hardware and the SDKs."},"3230":{"id":"/docs/server/running-11","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running","content":"The live pipeline does not serve browsers yet. It encodes every bundle and\nhands it to the debug recorder. See Serve to browsers for the\nstatus of the WebTransport server."},"3231":{"id":"/docs/server/running-12","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#before-you-start","content":"Build the server. The binary is `server/build/dev-debug/orbbec_streamer`\n(debug build) or `server/build/dev-relwithdebinfo/orbbec_streamer`\n(optimised build). Use the optimised build to measure latency."},"3232":{"id":"/docs/server/running-13","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#before-you-start","content":"Run every command from `server/`. The config file and the paths inside it\n(`models/...`, `config/dev/...`, `debug/live`) are relative to the working\ndirectory."},"3233":{"id":"/docs/server/running-14","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#before-you-start","content":"Check the config first; see Configuration."},"3234":{"id":"/docs/server/running-15","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"`config/dev/live.yaml` describes the development rig, not yours. As shipped\nit:"},"3235":{"id":"/docs/server/running-16","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"opens two cameras by the development rig's serial numbers, one as `primary`\nand one as `secondary` (serial numbers in these pages are placeholders)"},"3236":{"id":"/docs/server/running-17","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"enables hardware sync for those two cameras (`sync.enabled: true`)"},"3237":{"id":"/docs/server/running-18","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"uses `mask.backend: rvm` with the batch-2 RVM engine, which is not built by\ndefault"},"3238":{"id":"/docs/server/running-19","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"records the GPU inputs and outputs, decodes the outputs locally, and writes\nall of it to `debug/live` (several MKV and HEVC files that keep growing\nwhile the server runs)"},"3239":{"id":"/docs/server/running-20","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"Make your own copy and edit it:"},"3240":{"id":"/docs/server/running-21","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"Copy the config into `config/local/`, which `server/.gitignore` ignores,\nso your rig's settings stay out of commits:"},"3241":{"id":"/docs/server/running-22","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"Find your cameras' serial numbers. With the cameras connected, run\n`./build/dev-debug/orbbec_streamer --orbbec-test` and read the `serial`\nof each device."},"3242":{"id":"/docs/server/running-23","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"In `cameras`, set one entry per camera with its `serial_number`. With\nhardware sync, give exactly one camera `role: primary` and the others\n`role: secondary`. Without a sync cable, or with one camera, set\n`sync.enabled: false`."},"3243":{"id":"/docs/server/running-24","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"Choose the mask backend. Either build the RVM engine\n(Install) and point\n`mask.rvm_engine_path` at the engine whose batch size equals your number\nof cameras, or set `mask.backend: fill_all` to run without segmentation."},"3244":{"id":"/docs/server/running-25","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"Decide on debug recording. To write nothing but `setup.json`, set\n`debug_recording.record_gpu_inputs: false` and\n`debug_recording.record_gpu_outputs: false`. Otherwise make sure\n`debug_recording.camera_ids` lists your camera `id`s and the disk has\nroom."},"3245":{"id":"/docs/server/running-26","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#adapt-the-config-to-your-rig","content":"The commands on this page use `config/dev/live.yaml`. Replace it with\n`config/local/live.yaml` (or your own path) when you run them."},"3246":{"id":"/docs/server/running-27","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#check-the-hardware","content":"Run these before the first live run on a new machine. Each one prints its\nresult and exits."},"3247":{"id":"/docs/server/running-28","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#check-the-hardware","content":"Expected output on the development machine (RTX 4090, driver 580):"},"3248":{"id":"/docs/server/running-29","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#check-the-hardware","content":"`main10=true` and `encode_10bit=true` are required: depth is encoded as\n10-bit HEVC."},"3249":{"id":"/docs/server/running-30","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#check-the-hardware","content":"With the cameras connected, check the SDK and synchronised capture:"},"3250":{"id":"/docs/server/running-31","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#check-the-hardware","content":"`--orbbec-test` lists every Orbbec device (id, name, model, serial,\nfirmware) and ends with `Orbbec provider smoke test OK`.\n`--orbbec-live-sync-test` opens the cameras exactly as `--live` would, waits\nfor the warm-up, counts synchronised batches, and ends with\n`PASS: production live configuration is synchronizing all cameras` (exit\ncode 0) or `FAIL: <reason>` (exit code 1)."},"3251":{"id":"/docs/server/running-32","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Flag"},"3252":{"id":"/docs/server/running-33","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Argument"},"3253":{"id":"/docs/server/running-34","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"What it does"},"3254":{"id":"/docs/server/running-35","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--live`"},"3255":{"id":"/docs/server/running-36","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"config file"},"3256":{"id":"/docs/server/running-37","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Runs the live pipeline until stopped."},"3257":{"id":"/docs/server/running-38","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--calibrate-camera-pose`"},"3258":{"id":"/docs/server/running-39","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"none"},"3259":{"id":"/docs/server/running-40","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"With `--live`: runs a camera-pose calibration from the local console and commits it. Needs `streams.alignment: color_to_depth`."},"3260":{"id":"/docs/server/running-41","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--print-charuco-board`"},"3261":{"id":"/docs/server/running-42","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"PNG path"},"3262":{"id":"/docs/server/running-43","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Writes the calibration board as a 300 dpi PNG and exits. Uses the board from `--live <config>` if given, else the defaults. Cannot be combined with `--calibrate-camera-pose`."},"3263":{"id":"/docs/server/running-44","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--cuda-test`"},"3264":{"id":"/docs/server/running-45","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"none"},"3265":{"id":"/docs/server/running-46","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Prints the first CUDA device and runs a trivial kernel. It does not check whether the kernel launched, so it prints `CUDA smoke test OK` even when the build does not match your GPU. Use `ctest --test-dir build/dev-debug -L unit` to detect that."},"3266":{"id":"/docs/server/running-47","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--nvenc-test`"},"3267":{"id":"/docs/server/running-48","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"none"},"3268":{"id":"/docs/server/running-49","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Opens an NVENC session and prints the HEVC capabilities."},"3269":{"id":"/docs/server/running-50","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--compression-test`"},"3270":{"id":"/docs/server/running-51","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"none"},"3271":{"id":"/docs/server/running-52","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Placeholder: prints `Compression smoke test OK` and tests nothing."},"3272":{"id":"/docs/server/running-53","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--websocket-test`"},"3273":{"id":"/docs/server/running-54","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"none"},"3274":{"id":"/docs/server/running-55","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Placeholder: prints `WebSocket smoke test OK` and opens no socket."},"3275":{"id":"/docs/server/running-56","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--orbbec-test`"},"3276":{"id":"/docs/server/running-57","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"none"},"3277":{"id":"/docs/server/running-58","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Lists the connected Orbbec devices. Needs cameras."},"3278":{"id":"/docs/server/running-59","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--orbbec-capture-test`"},"3279":{"id":"/docs/server/running-60","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"none"},"3280":{"id":"/docs/server/running-61","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Captures a few batches from all connected cameras through GPU upload (10 s timeout) and prints FPS telemetry. Needs cameras."},"3281":{"id":"/docs/server/running-62","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--orbbec-live-sync-test`"},"3282":{"id":"/docs/server/running-63","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"none"},"3283":{"id":"/docs/server/running-64","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Checks synchronised capture with a live config. Needs cameras."},"3284":{"id":"/docs/server/running-65","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--config`"},"3285":{"id":"/docs/server/running-66","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"config file"},"3286":{"id":"/docs/server/running-67","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Config for `--orbbec-live-sync-test` only. Default `config/dev/live.yaml`."},"3287":{"id":"/docs/server/running-68","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--warmup-s`"},"3288":{"id":"/docs/server/running-69","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"seconds"},"3289":{"id":"/docs/server/running-70","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Warm-up before measuring, for `--orbbec-live-sync-test`. Default `5`."},"3290":{"id":"/docs/server/running-71","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--duration-s`"},"3291":{"id":"/docs/server/running-72","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"seconds"},"3292":{"id":"/docs/server/running-73","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Measurement time, for `--orbbec-live-sync-test`. Default `10`."},"3293":{"id":"/docs/server/running-74","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--minimum-rate-ratio`"},"3294":{"id":"/docs/server/running-75","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"ratio"},"3295":{"id":"/docs/server/running-76","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Pass threshold: measured batch rate divided by the configured depth fps. Default `0.9`."},"3296":{"id":"/docs/server/running-77","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`-h`, `--help`"},"3297":{"id":"/docs/server/running-78","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"none"},"3298":{"id":"/docs/server/running-79","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Prints the flags."},"3299":{"id":"/docs/server/running-80","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"`--config` does not select the config for `--live`; `--live` takes the file\nitself."},"3300":{"id":"/docs/server/running-81","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#command-line-reference","content":"Exit codes: `0` success, `1` a run-time error (logged as\n`orbbec-streamer failed: <reason>`), `2` an invalid flag combination, and a\nCLI11 error code for a command-line parse error, for example `109` for an\nunknown flag."},"3301":{"id":"/docs/server/running-82","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#start-the-live-pipeline","content":"To keep a log file and the rate tables as plain log lines:"},"3302":{"id":"/docs/server/running-83","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#start-the-live-pipeline","content":"On an interactive terminal the rate tables are redrawn in place on a\nseparate screen. `ORBBEC_STREAMER_STATUS_MODE=log` prints them as ordinary\nlog lines instead; `=dashboard` forces the in-place display. See\nRead the telemetry."},"3303":{"id":"/docs/server/running-84","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#expected-result","content":"A healthy start with two synchronised cameras (abridged from a real run on\n2026-09-26, updated for the current queue settings; recording paths shortened,\n`mask.backend: fill_all`, no display):"},"3304":{"id":"/docs/server/running-85","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#expected-result","content":"What to check:"},"3305":{"id":"/docs/server/running-86","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#expected-result","content":"`live selected N active camera(s), neglected 0 camera(s)`: every configured\ncamera was found."},"3306":{"id":"/docs/server/running-87","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#expected-result","content":"One `Configured Orbbec sync` line per camera: `mode=4` is the primary,\n`mode=8` a secondary."},"3307":{"id":"/docs/server/running-88","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#expected-result","content":"`live pipeline started`: capture, GPU processing and encoding are running."},"3308":{"id":"/docs/server/running-89","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#expected-result","content":"After about 6 s, the first rate table shows every stage at the configured\nframe rate and `0` drops."},"3309":{"id":"/docs/server/running-90","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#expected-result","content":"With `mask.backend: rvm` an extra line starting `initialized TensorRT` appears\nbefore the pipeline starts. With `run.preview: true` and a display, a preview\nwindow opens when the first processed frame arrives; press `q` or `Esc` in it\nto stop the server. The preview runs on its own thread and shows the newest\nframe it can keep up with, so it never blocks capture, processing or\nencoding. Without a\ndisplay, the warning `no DISPLAY or WAYLAND_DISPLAY is available; disabling\nthe live preview window` appears at that point instead, and the preview stays\noff for the rest of the run."},"3310":{"id":"/docs/server/running-91","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#expected-result","content":"`setup at startup: ... needs-setup` only means no camera-pose calibration is\ncommitted yet. The pipeline still runs."},"3311":{"id":"/docs/server/running-92","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#debug-recording-output","content":"With `debug_recording.record_gpu_inputs` or `record_gpu_outputs` set, files go\nto `debug_recording.directory` (default `debug/live`, relative to the working\ndirectory). The server prints a `DEBUG RECORDING` table with every path when\nrecording starts."},"3312":{"id":"/docs/server/running-93","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#debug-recording-output","content":"In `per_camera` mode the encoded output goes to each camera's folder\n(`cam0/gpu-output-*`) instead of `multicam/`. Folder names are the camera\n`id`s from the config. `debug_recording.camera_ids` limits which cameras are\nrecorded. Recordings are closed when the server stops, so stop it with a\nsignal, not `kill -9`."},"3313":{"id":"/docs/server/running-94","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#stop-the-server","content":"Press `Ctrl+C` in its terminal, or send `SIGTERM`:"},"3314":{"id":"/docs/server/running-95","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#stop-the-server","content":"Both set a stop flag. The main loop checks it once per second, then stops\ncapture, upload, processing and encoding in that order, finishes the\nrecordings, and prints the session summary. The last line is:"},"3315":{"id":"/docs/server/running-96","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#stop-the-server","content":"A worker error stops the server the same way, then logs\n`orbbec-streamer failed: <reason>` and exits with code 1."},"3316":{"id":"/docs/server/running-97","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"The Orbbec SDK writes its own log to `Log/OrbbecSDK.log.txt` in the working\ndirectory. Look there first for camera errors."},"3317":{"id":"/docs/server/running-98","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"Symptom"},"3318":{"id":"/docs/server/running-99","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"Cause and fix"},"3319":{"id":"/docs/server/running-100","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`orbbec-streamer failed: Request failed, device response with unknown error! propertyId: 1038` right after the first `Configured Orbbec sync` line"},"3320":{"id":"/docs/server/running-101","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"A camera rejected the multi-device sync configuration. The cameras are stuck in a bad sync state. Power-cycle every camera: disconnect power and USB, wait a few seconds, reconnect. Restarting the server does not help."},"3321":{"id":"/docs/server/running-102","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`Orbbec synchronization role readback mismatch for camera <id>`"},"3322":{"id":"/docs/server/running-103","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"The camera did not accept its primary/secondary role. Check the sync cable and `cameras[].role`, then power-cycle the cameras."},"3323":{"id":"/docs/server/running-104","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`neglecting missing camera: config_id=... serial='...'`"},"3324":{"id":"/docs/server/running-105","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"A configured camera was not found within `run.camera_wait_timeout_ms`. Check the USB connection and the serial with `--orbbec-test`. The server continues with the cameras it found, even for cameras with `required: true`."},"3325":{"id":"/docs/server/running-106","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`No configured cameras are active; live mode cannot continue`"},"3326":{"id":"/docs/server/running-107","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"No configured camera was found. Same checks as above."},"3327":{"id":"/docs/server/running-108","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`Orbbec global timestamps are required ... not supported by camera`"},"3328":{"id":"/docs/server/running-109","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"The camera firmware does not support global timestamps. Update the camera firmware."},"3329":{"id":"/docs/server/running-110","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`--cuda-test` prints `CUDA error: ...`"},"3330":{"id":"/docs/server/running-111","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"No usable CUDA device or driver. Check `nvidia-smi`. `--cuda-test` still exits with code 0 in this case, so read its output."},"3331":{"id":"/docs/server/running-112","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`orbbec-streamer failed: cudaMalloc failed: ...` or another `... failed: <CUDA error>`"},"3332":{"id":"/docs/server/running-113","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"CUDA failed during the run. Check `nvidia-smi` for the driver and free GPU memory."},"3333":{"id":"/docs/server/running-114","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`NvEncOpenEncodeSessionEx failed with NVENC status 10`"},"3334":{"id":"/docs/server/running-115","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"No NVENC session available (status 10 is `NV_ENC_ERR_OUT_OF_MEMORY`, which the driver also returns when its session limit is reached). The server opens 2 sessions in `concatenated_batch` mode and 2 per camera in `per_camera` mode. Stop other encoders (another `orbbec_streamer`, OBS, ffmpeg) and check `nvidia-smi --query-gpu=encoder.stats.sessionCount --format=csv`. Consumer GeForce drivers limit concurrent sessions."},"3335":{"id":"/docs/server/running-116","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`orbbec-streamer failed: Cannot open TensorRT engine: models/rvm/generated/...`"},"3336":{"id":"/docs/server/running-117","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`mask.backend: rvm`, but the engine file does not exist. Build it with `scripts/setup_rvm.py`, or set `mask.backend: fill_all` to run without segmentation. This error comes after the cameras are opened."},"3337":{"id":"/docs/server/running-118","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`--calibrate-camera-pose requires streams.alignment: color_to_depth`"},"3338":{"id":"/docs/server/running-119","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"Set `streams.alignment: color_to_depth` in the config."},"3339":{"id":"/docs/server/running-120","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`setup state not built: client-facing setup requires streams.alignment=color_to_depth`"},"3340":{"id":"/docs/server/running-121","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"Warning only. Capture and encoding run, but no client-facing setup state is built."},"3341":{"id":"/docs/server/running-122","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`no DISPLAY or WAYLAND_DISPLAY is available; disabling the live preview window`"},"3342":{"id":"/docs/server/running-123","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"Warning only, on a headless machine. Set `run.preview: false` to silence it."},"3343":{"id":"/docs/server/running-124","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`upload queue full: dropped the oldest captured batch`, `processing queue full: ...` or `encode queue full: ...`"},"3344":{"id":"/docs/server/running-125","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"A stage fell behind; its short queue dropped the oldest batch so the newest frames go on. See Read the telemetry."},"3345":{"id":"/docs/server/running-126","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"`Failed to open live config: <path>`"},"3346":{"id":"/docs/server/running-127","page_id":"/docs/server/running","tags":[],"type":"text","url":"/docs/server/running#troubleshooting","content":"Wrong path. Run from `server/` or pass an absolute path."},"3347":{"id":"/docs/server/serving","page_id":"/docs/server/serving","type":"page","content":"Serve to browsers","breadcrumbs":["HSLU OrbbecStreamer","Server","Operate"],"tags":[],"url":"/docs/server/serving"},"3348":{"id":"/docs/server/serving-0","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving","content":"Status of the WebTransport server, the TLS certificates browsers need, and how to try the WebTransport spike."},"3349":{"id":"/docs/server/serving-1","page_id":"/docs/server/serving","type":"heading","tags":[],"url":"/docs/server/serving#status","content":"Status"},"3350":{"id":"/docs/server/serving-2","page_id":"/docs/server/serving","type":"heading","tags":[],"url":"/docs/server/serving#the-planned-model","content":"The planned model"},"3351":{"id":"/docs/server/serving-3","page_id":"/docs/server/serving","type":"heading","tags":[],"url":"/docs/server/serving#tls-certificates","content":"TLS certificates"},"3352":{"id":"/docs/server/serving-4","page_id":"/docs/server/serving","type":"heading","tags":[],"url":"/docs/server/serving#development-a-pinned-certificate-hash","content":"Development: a pinned certificate hash"},"3353":{"id":"/docs/server/serving-5","page_id":"/docs/server/serving","type":"heading","tags":[],"url":"/docs/server/serving#production-a-ca-issued-certificate","content":"Production: a CA-issued certificate"},"3354":{"id":"/docs/server/serving-6","page_id":"/docs/server/serving","type":"heading","tags":[],"url":"/docs/server/serving#try-the-webtransport-spike","content":"Try the WebTransport spike"},"3355":{"id":"/docs/server/serving-7","page_id":"/docs/server/serving","type":"heading","tags":[],"url":"/docs/server/serving#expected-result","content":"Expected result"},"3356":{"id":"/docs/server/serving-8","page_id":"/docs/server/serving","type":"heading","tags":[],"url":"/docs/server/serving#troubleshooting","content":"Troubleshooting"},"3357":{"id":"/docs/server/serving-9","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving","content":"Browsers will connect to the server over WebTransport (HTTP/3 over QUIC,\nalways TLS). Each browser gets one session: a control stream plus one stream\neach for colour and depth. The wire format is defined in\n`protocol/wire-format.md`."},"3358":{"id":"/docs/server/serving-10","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"**Not yet available.** The server does not accept browser connections today.\n`--live` captures, processes and encodes, but hands the encoded bundles only\nto the debug recorder. There is no listening socket and no port to open."},"3359":{"id":"/docs/server/serving-11","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"What exists:"},"3360":{"id":"/docs/server/serving-12","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"Part"},"3361":{"id":"/docs/server/serving-13","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"Status"},"3362":{"id":"/docs/server/serving-14","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"Transport choice"},"3363":{"id":"/docs/server/serving-15","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"ADR 0002 (`server/docs/architecture/adr/0002-webtransport-server.md`), status *Proposed*: a Go `webtransport-go` gateway in front of the C++ server."},"3364":{"id":"/docs/server/serving-16","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"Session and control logic (`src/session/SessionHub`)"},"3365":{"id":"/docs/server/serving-17","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"Implemented and unit-tested, not connected to a network listener."},"3366":{"id":"/docs/server/serving-18","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"HTTPS/HTTP3/WebTransport listener"},"3367":{"id":"/docs/server/serving-19","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"Not implemented (roadmap P3)."},"3368":{"id":"/docs/server/serving-20","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"WebTransport spike (`server/spike/webtransport`)"},"3369":{"id":"/docs/server/serving-21","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"A throwaway experiment with synthetic media. It shows that Chromium works with the chosen stack. Not a server for real cameras."},"3370":{"id":"/docs/server/serving-22","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"`--websocket-test`"},"3371":{"id":"/docs/server/serving-23","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#status","content":"A placeholder that prints `WebSocket smoke test OK`. WebSocket is not and will not be the production transport."},"3372":{"id":"/docs/server/serving-24","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#the-planned-model","content":"This is the design in ADR 0002. Details may change before it ships."},"3373":{"id":"/docs/server/serving-25","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#the-planned-model","content":"The C++ server starts and supervises a small Go gateway process. The\ngateway owns the UDP port, TLS and the WebTransport sessions."},"3374":{"id":"/docs/server/serving-26","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#the-planned-model","content":"The C++ server keeps all media decisions: per-client bounded queues,\ndropping for slow clients, keyframe recovery, revisions. The gateway only\nmoves bytes."},"3375":{"id":"/docs/server/serving-27","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#the-planned-model","content":"Encoded frames are passed to the gateway through shared memory, without a\ncopy per client."},"3376":{"id":"/docs/server/serving-28","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#the-planned-model","content":"A slow browser can only slow its own session. It never blocks capture, GPU\nprocessing or encoding."},"3377":{"id":"/docs/server/serving-29","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#the-planned-model","content":"The UDP port and the certificate settings will live in a gateway section of\nthe server config. That section does not exist yet."},"3378":{"id":"/docs/server/serving-30","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#tls-certificates","content":"WebTransport always uses TLS. There are two ways for a browser to trust the\nserver."},"3379":{"id":"/docs/server/serving-31","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#development-a-pinned-certificate-hash","content":"The browser can skip the CA check if the page passes the certificate's\nSHA-256 hash in `serverCertificateHashes`. Browsers accept this only when the\ncertificate:"},"3380":{"id":"/docs/server/serving-32","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#development-a-pinned-certificate-hash","content":"is an X.509v3 certificate,"},"3381":{"id":"/docs/server/serving-33","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#development-a-pinned-certificate-hash","content":"uses an ECDSA P-256 key (RSA is rejected),"},"3382":{"id":"/docs/server/serving-34","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#development-a-pinned-certificate-hash","content":"is valid for less than 14 days in total."},"3383":{"id":"/docs/server/serving-35","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#development-a-pinned-certificate-hash","content":"The planned gateway will generate and rotate such a certificate itself (13\ndays), as the spike already does. To make one by hand:"},"3384":{"id":"/docs/server/serving-36","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#development-a-pinned-certificate-hash","content":"Replace `localhost` and `127.0.0.1` with the server's host name and IP if\nthe browser runs on another machine. Check the result:"},"3385":{"id":"/docs/server/serving-37","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#development-a-pinned-certificate-hash","content":"Compute the SHA-256 hash of the certificate (of its DER bytes, not the PEM\nfile):"},"3386":{"id":"/docs/server/serving-38","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#development-a-pinned-certificate-hash","content":"The browser takes these 32 bytes as the `value` of a\n`{ algorithm: 'sha-256', value }` entry in `serverCertificateHashes`. The\nsame hash as Base64, if the client wants that form:"},"3387":{"id":"/docs/server/serving-39","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#development-a-pinned-certificate-hash","content":"Make a new certificate before the old one expires; the hash changes every\ntime. Safari is assumed not to support `serverCertificateHashes`; use a\nCA-issued certificate for Safari."},"3388":{"id":"/docs/server/serving-40","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#production-a-ca-issued-certificate","content":"For real deployments use a certificate from a public CA (for example Let's\nEncrypt) or from a CA that the client machines trust, issued for the host\nname the browsers use. The browser then connects without a hash, and the\n14-day and ECDSA limits do not apply. How the gateway will load it will be\ndocumented when the gateway exists."},"3389":{"id":"/docs/server/serving-41","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"The spike runs a WebTransport server with synthetic colour and depth frames\nshaped like the wire format, plus a test page. Use it to check that a\nbrowser on your machine can open a WebTransport session with a pinned\ncertificate. It does not use cameras or the C++ server."},"3390":{"id":"/docs/server/serving-42","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"It needs Go 1.27.1 or newer (`go.mod` says `go 1.27.1`) with `go` on `PATH`.\nInstall it from go.dev/dl and check with `go version`."},"3391":{"id":"/docs/server/serving-43","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Build and start the server for 60 s of media:"},"3392":{"id":"/docs/server/serving-44","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"The first run downloads the Go modules pinned in `go.sum`."},"3393":{"id":"/docs/server/serving-45","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Open `http://localhost:8080/` in Chrome or Chromium on the same machine.\nThe page opens `https://127.0.0.1:4433/session` with the pinned hash.\nAlternatively run it headless:"},"3394":{"id":"/docs/server/serving-46","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Headless Chromium does not exit on its own; stop it with `Ctrl+C` after\nthe server has printed its verdict. The `--user-data-dir` above suits the\nsnap package of Chromium; any fresh empty directory works for other\nbuilds."},"3395":{"id":"/docs/server/serving-47","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Useful flags of `./day1`:"},"3396":{"id":"/docs/server/serving-48","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Flag"},"3397":{"id":"/docs/server/serving-49","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Default"},"3398":{"id":"/docs/server/serving-50","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Meaning"},"3399":{"id":"/docs/server/serving-51","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`-duration`"},"3400":{"id":"/docs/server/serving-52","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`60s`"},"3401":{"id":"/docs/server/serving-53","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"How long media is sent."},"3402":{"id":"/docs/server/serving-54","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`-rate`"},"3403":{"id":"/docs/server/serving-55","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`60`"},"3404":{"id":"/docs/server/serving-56","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Bundles per second."},"3405":{"id":"/docs/server/serving-57","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`-color-bytes` / `-depth-bytes`"},"3406":{"id":"/docs/server/serving-58","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`150000` / `60000`"},"3407":{"id":"/docs/server/serving-59","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Size of each synthetic access unit."},"3408":{"id":"/docs/server/serving-60","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`-gop`"},"3409":{"id":"/docs/server/serving-61","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`60`"},"3410":{"id":"/docs/server/serving-62","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Keyframe interval."},"3411":{"id":"/docs/server/serving-63","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`-pace`"},"3412":{"id":"/docs/server/serving-64","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`1`"},"3413":{"id":"/docs/server/serving-65","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Split each access unit into this many writes spread over the frame interval."},"3414":{"id":"/docs/server/serving-66","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`-wt`"},"3415":{"id":"/docs/server/serving-67","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`127.0.0.1:4433`"},"3416":{"id":"/docs/server/serving-68","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"WebTransport address (UDP)."},"3417":{"id":"/docs/server/serving-69","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`-http`"},"3418":{"id":"/docs/server/serving-70","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`localhost:8080`"},"3419":{"id":"/docs/server/serving-71","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Address of the test page (plain HTTP)."},"3420":{"id":"/docs/server/serving-72","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"`-report`"},"3421":{"id":"/docs/server/serving-73","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"none"},"3422":{"id":"/docs/server/serving-74","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#try-the-webtransport-spike","content":"Also write the page's report JSON to this file."},"3423":{"id":"/docs/server/serving-75","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#expected-result","content":"A 5 s run with headless Chromium 153 on the development machine:"},"3424":{"id":"/docs/server/serving-76","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#expected-result","content":"WebTransport works when `client.hello` arrives and every record sent is\nreceived with 0 gaps. The final `DAY 1 PASS` / `DAY 1 FAIL` also requires a\ncontrol round trip below 5 ms at p99, which unpaced 60 Hz media usually\nmisses in Chromium; add `-pace 8` to reproduce the passing configuration\nfrom the spike report. The full results are in\n`server/spike/webtransport/README.md`."},"3425":{"id":"/docs/server/serving-77","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"Symptom"},"3426":{"id":"/docs/server/serving-78","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"Cause and fix"},"3427":{"id":"/docs/server/serving-79","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"The page never connects; no `client.hello` in the server log"},"3428":{"id":"/docs/server/serving-80","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"The browser did not use QUIC to `127.0.0.1:4433`. Use Chrome/Chromium on the same machine as the server, and check with `ss -ulpn` that nothing else uses UDP port 4433."},"3429":{"id":"/docs/server/serving-81","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"Browser error about the certificate or `serverCertificateHashes`"},"3430":{"id":"/docs/server/serving-82","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"The certificate breaks a browser rule: not ECDSA P-256, or valid for 14 days or more. Recreate it with the command above. For the spike, restart it: it makes a new certificate every start."},"3431":{"id":"/docs/server/serving-83","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"The hash is rejected although the certificate is fine"},"3432":{"id":"/docs/server/serving-84","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"The hash was computed over the PEM file. Hash the DER bytes as shown above."},"3433":{"id":"/docs/server/serving-85","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"`go: command not found`"},"3434":{"id":"/docs/server/serving-86","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"Go is not installed or not on `PATH`. Install Go 1.27.1 or newer and add its `bin` folder to `PATH`."},"3435":{"id":"/docs/server/serving-87","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"Safari does not connect with a hash"},"3436":{"id":"/docs/server/serving-88","page_id":"/docs/server/serving","tags":[],"type":"text","url":"/docs/server/serving#troubleshooting","content":"Expected; Safari needs a CA-issued certificate."},"3437":{"id":"/docs/server/setup-state","page_id":"/docs/server/setup-state","type":"page","content":"Setup state","breadcrumbs":["HSLU OrbbecStreamer","Server","How it works"],"tags":[],"url":"/docs/server/setup-state"},"3438":{"id":"/docs/server/setup-state-0","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state","content":"The server's setup and readiness model, how it maps to the wire, the revisions, the setup lease, autocalibrate and setup.json."},"3439":{"id":"/docs/server/setup-state-1","page_id":"/docs/server/setup-state","type":"heading","tags":[],"url":"/docs/server/setup-state#phases-and-readiness","content":"Phases and readiness"},"3440":{"id":"/docs/server/setup-state-2","page_id":"/docs/server/setup-state","type":"heading","tags":[],"url":"/docs/server/setup-state#in-the-log","content":"In the log"},"3441":{"id":"/docs/server/setup-state-3","page_id":"/docs/server/setup-state","type":"heading","tags":[],"url":"/docs/server/setup-state#revisions","content":"Revisions"},"3442":{"id":"/docs/server/setup-state-4","page_id":"/docs/server/setup-state","type":"heading","tags":[],"url":"/docs/server/setup-state#setup-lease","content":"Setup lease"},"3443":{"id":"/docs/server/setup-state-5","page_id":"/docs/server/setup-state","type":"heading","tags":[],"url":"/docs/server/setup-state#autocalibrate","content":"`autocalibrate`"},"3444":{"id":"/docs/server/setup-state-6","page_id":"/docs/server/setup-state","type":"heading","tags":[],"url":"/docs/server/setup-state#setupjson","content":"`setup.json`"},"3445":{"id":"/docs/server/setup-state-7","page_id":"/docs/server/setup-state","type":"heading","tags":[],"url":"/docs/server/setup-state#what-works-today","content":"What works today"},"3446":{"id":"/docs/server/setup-state-8","page_id":"/docs/server/setup-state","type":"heading","tags":[],"url":"/docs/server/setup-state#related-pages","content":"Related pages"},"3447":{"id":"/docs/server/setup-state-9","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state","content":"The server keeps one authoritative setup state: whether the rig is\ncalibrated, whether media may flow, who holds the setup lock, and the\nrevisions clients need to interpret the media. Clients will read it from the\nsnapshot and follow its updates; today you see it in the server log. The wire\nform is defined in `protocol/wire-format.md` §10–§12 and §18."},"3448":{"id":"/docs/server/setup-state-10","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state","content":"The state machine (`src/control/SetupController`) is implemented and tested.\nThe network layer that carries it to clients is not available yet; see\nWhat works today."},"3449":{"id":"/docs/server/setup-state-11","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"Internally the server names one phase for logs. On the wire the same state\nis split into independent fields, and the internal names never appear there."},"3450":{"id":"/docs/server/setup-state-12","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"Internal phase (log)"},"3451":{"id":"/docs/server/setup-state-13","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"When"},"3452":{"id":"/docs/server/setup-state-14","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"On the wire (§10)"},"3453":{"id":"/docs/server/setup-state-15","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`NEEDS_SETUP`"},"3454":{"id":"/docs/server/setup-state-16","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"Camera pose missing, stale or failed; `autocalibrate: false`"},"3455":{"id":"/docs/server/setup-state-17","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`readiness=needs-setup`, `autocalibrate=false`"},"3456":{"id":"/docs/server/setup-state-18","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`WAITING_FOR_CALIBRATION`"},"3457":{"id":"/docs/server/setup-state-19","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"Camera pose missing, stale or failed; `autocalibrate: true`"},"3458":{"id":"/docs/server/setup-state-20","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`readiness=needs-setup`, `autocalibrate=true`"},"3459":{"id":"/docs/server/setup-state-21","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`CALIBRATING`"},"3460":{"id":"/docs/server/setup-state-22","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"A lease holder runs a camera-pose calibration"},"3461":{"id":"/docs/server/setup-state-23","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"Lock owned, `camera-pose` calibration `running`"},"3462":{"id":"/docs/server/setup-state-24","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`READY`"},"3463":{"id":"/docs/server/setup-state-25","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"Camera pose valid, media not requested"},"3464":{"id":"/docs/server/setup-state-26","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`readiness=ready`, `streaming=stopped`"},"3465":{"id":"/docs/server/setup-state-27","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`STREAMING`"},"3466":{"id":"/docs/server/setup-state-28","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"Camera pose valid, media requested, no calibration running"},"3467":{"id":"/docs/server/setup-state-29","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`readiness=ready`, `streaming=streaming`"},"3468":{"id":"/docs/server/setup-state-30","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`PAUSED_FOR_SETUP`"},"3469":{"id":"/docs/server/setup-state-31","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"Ready, but media held for a setup operation"},"3470":{"id":"/docs/server/setup-state-32","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"`readiness=ready`, `streaming=paused-for-setup`"},"3471":{"id":"/docs/server/setup-state-33","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"Rules behind the table:"},"3472":{"id":"/docs/server/setup-state-34","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"**Readiness depends only on the camera pose.** A linear depth quantization\nprofile is usable without calibration, and network calibration is\nadvisory."},"3473":{"id":"/docs/server/setup-state-35","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"**A recalibration keeps the server ready.** While a new run replaces a\nvalid pose, the committed poses stay in use, readiness stays `ready` and\nmedia is paused for setup. The log shows `CALIBRATING`."},"3474":{"id":"/docs/server/setup-state-36","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"**Media flows only when ready.** Streaming is `streaming` only when media is\nrequested, the pose is valid and no calibration is running. `--live`\nrequests media at start, so a valid pose shows `STREAMING` in the log. No\nbytes leave the server until serving exists."},"3475":{"id":"/docs/server/setup-state-37","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"An `error` phase is not modelled yet."},"3476":{"id":"/docs/server/setup-state-38","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#phases-and-readiness","content":"What makes a saved pose valid or stale, and the procedure to calibrate, are\non Camera pose calibration."},"3477":{"id":"/docs/server/setup-state-39","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#in-the-log","content":"At start, after the cameras are open:"},"3478":{"id":"/docs/server/setup-state-40","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#in-the-log","content":"After that, a `setup update` line appears whenever the phase, the camera-pose\ncalibration, the streaming state or the lock owner changes. Lease heartbeats\nare not logged."},"3479":{"id":"/docs/server/setup-state-41","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"Every change a client needs to interpret media carries a revision. Revisions\nnever decrease, and content that affects interpretation changes only with a\nnewer revision."},"3480":{"id":"/docs/server/setup-state-42","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"Revision"},"3481":{"id":"/docs/server/setup-state-43","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"Starts at"},"3482":{"id":"/docs/server/setup-state-44","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"Changes when"},"3483":{"id":"/docs/server/setup-state-45","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"Persisted"},"3484":{"id":"/docs/server/setup-state-46","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"`calibrationRevision` (camera pose)"},"3485":{"id":"/docs/server/setup-state-47","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"The revision in `camera-pose.json`; `0` without a file"},"3486":{"id":"/docs/server/setup-state-48","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"A calibration is committed: previous + 1, also when the previous pose was stale"},"3487":{"id":"/docs/server/setup-state-49","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"Yes, in `camera-pose.json`"},"3488":{"id":"/docs/server/setup-state-50","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"`depthQuantizationRevision`"},"3489":{"id":"/docs/server/setup-state-51","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"`1`"},"3490":{"id":"/docs/server/setup-state-52","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"Never while running. Changing the profile needs a restart."},"3491":{"id":"/docs/server/setup-state-53","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"No"},"3492":{"id":"/docs/server/setup-state-54","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"`placementRevision`"},"3493":{"id":"/docs/server/setup-state-55","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"`0`"},"3494":{"id":"/docs/server/setup-state-56","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"A client commits a new placement (`client.placement.commit`): + 1"},"3495":{"id":"/docs/server/setup-state-57","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"No: placement is kept in memory and resets at restart"},"3496":{"id":"/docs/server/setup-state-58","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"`metadataRevision`"},"3497":{"id":"/docs/server/setup-state-59","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"`1` at every start"},"3498":{"id":"/docs/server/setup-state-60","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"Once per authoritative update message (lock, calibration state, readiness, streaming, descriptors, …)"},"3499":{"id":"/docs/server/setup-state-61","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"No"},"3500":{"id":"/docs/server/setup-state-62","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#revisions","content":"Stream descriptors carry the metadata revision at which something they depend\non last changed, not the current one. A lock or streaming change therefore\nnever rotates media streams; a new calibration, placement or quantization\ndoes (§18). Because `metadataRevision` restarts at 1, a client that\nreconnects after a server restart takes the full snapshot, as it does after\nany reconnect (§17)."},"3501":{"id":"/docs/server/setup-state-63","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"Setup operations (calibration, placement) need the setup lock. There is one\nper server."},"3502":{"id":"/docs/server/setup-state-64","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"Property"},"3503":{"id":"/docs/server/setup-state-65","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"Value"},"3504":{"id":"/docs/server/setup-state-66","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"Holders"},"3505":{"id":"/docs/server/setup-state-67","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"One connection at a time; others are rejected with `lock-held`"},"3506":{"id":"/docs/server/setup-state-68","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"Expiry"},"3507":{"id":"/docs/server/setup-state-69","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"15 s after acquiring or the last heartbeat (fixed, not configurable)"},"3508":{"id":"/docs/server/setup-state-70","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"Heartbeat"},"3509":{"id":"/docs/server/setup-state-71","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"Every 5 s from the holder"},"3510":{"id":"/docs/server/setup-state-72","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"Lease id"},"3511":{"id":"/docs/server/setup-state-73","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"128 random bits, sent only to the holding connection; never valid after a reconnect"},"3512":{"id":"/docs/server/setup-state-74","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"Ends on"},"3513":{"id":"/docs/server/setup-state-75","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"Release, disconnect, expiry. Ending the lease cancels a running calibration."},"3514":{"id":"/docs/server/setup-state-76","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setup-lease","content":"The lock state is broadcast to every client. Clients without the lock keep\ntheir normal control connection and see every state change.\n`--live --calibrate-camera-pose` takes the lease as the local console,\nheartbeats it every 5 s and releases it when the run ends."},"3515":{"id":"/docs/server/setup-state-77","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#autocalibrate","content":"`calibration.autocalibrate` is read at start and fixed for the run."},"3516":{"id":"/docs/server/setup-state-78","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#autocalibrate","content":"Value"},"3517":{"id":"/docs/server/setup-state-79","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#autocalibrate","content":"With a missing or stale pose"},"3518":{"id":"/docs/server/setup-state-80","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#autocalibrate","content":"`false` (default)"},"3519":{"id":"/docs/server/setup-state-81","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#autocalibrate","content":"A client may not start a calibration (`calibration-requires-operator`); an operator calibrates on the server with `--calibrate-camera-pose`. Phase `NEEDS_SETUP`."},"3520":{"id":"/docs/server/setup-state-82","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#autocalibrate","content":"`true`"},"3521":{"id":"/docs/server/setup-state-83","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#autocalibrate","content":"A client holding the lease may start the calibration itself; normal media is held until it is committed. Phase `WAITING_FOR_CALIBRATION`."},"3522":{"id":"/docs/server/setup-state-84","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#autocalibrate","content":"In both modes a valid pose may be recalibrated by the lease holder. Until\nclients can connect, `true` only changes the phase name in the log; keep it\n`false`. See Configuration."},"3523":{"id":"/docs/server/setup-state-85","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"At every start, after the cameras are running, the server writes\n`<debug_recording.directory>/setup.json` (default `debug/live/setup.json`),\neven with recording off. It is a local debug file for tools and recordings,\nnot part of the client protocol, and it is overwritten on each start."},"3524":{"id":"/docs/server/setup-state-86","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"Section"},"3525":{"id":"/docs/server/setup-state-87","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"Contents"},"3526":{"id":"/docs/server/setup-state-88","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"`schema_version`"},"3527":{"id":"/docs/server/setup-state-89","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"`1`"},"3528":{"id":"/docs/server/setup-state-90","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"`cameras`"},"3529":{"id":"/docs/server/setup-state-91","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"Per camera: config `id`, `runtime_id` (`orbbec:<serial>`), `serial_number`, `physical_index`, and depth intrinsics (`width`, `height`, `fx`, `fy`, `cx`, `cy`)"},"3530":{"id":"/docs/server/setup-state-92","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"`streams.color`"},"3531":{"id":"/docs/server/setup-state-93","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"`hevc`, NV12, source and encoded size, fps"},"3532":{"id":"/docs/server/setup-state-94","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"`streams.depth`"},"3533":{"id":"/docs/server/setup-state-95","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"`hevc_main10`, P010, source and encoded size, fps, and the depth packing: `quantized_p010_v1`, profile kind, depth range, the special codes and the 1024-entry reconstruction LUT in mm"},"3534":{"id":"/docs/server/setup-state-96","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"`encoding`"},"3535":{"id":"/docs/server/setup-state-97","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"`session_mode` and `camera_order`"},"3536":{"id":"/docs/server/setup-state-98","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#setupjson","content":"It does not contain camera poses, revisions or the setup phase. Poses are in\n`calibration.camera_pose_path`; the phase is in the log."},"3537":{"id":"/docs/server/setup-state-99","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Part"},"3538":{"id":"/docs/server/setup-state-100","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Status"},"3539":{"id":"/docs/server/setup-state-101","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Setup state, readiness and revisions, built at start"},"3540":{"id":"/docs/server/setup-state-102","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Available (needs `streams.alignment: color_to_depth`)"},"3541":{"id":"/docs/server/setup-state-103","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Loading and checking the saved camera pose"},"3542":{"id":"/docs/server/setup-state-104","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Available"},"3543":{"id":"/docs/server/setup-state-105","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Local calibration with the console lease (`--calibrate-camera-pose`)"},"3544":{"id":"/docs/server/setup-state-106","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Available"},"3545":{"id":"/docs/server/setup-state-107","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"`setup.json`"},"3546":{"id":"/docs/server/setup-state-108","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Available"},"3547":{"id":"/docs/server/setup-state-109","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Snapshot and updates sent to clients"},"3548":{"id":"/docs/server/setup-state-110","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Needs the network layer (not yet available)"},"3549":{"id":"/docs/server/setup-state-111","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Lease acquire, heartbeat and release by clients"},"3550":{"id":"/docs/server/setup-state-112","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Needs the network layer"},"3551":{"id":"/docs/server/setup-state-113","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Calibration started, cancelled or committed by a client; `autocalibrate: true`"},"3552":{"id":"/docs/server/setup-state-114","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Needs the network layer"},"3553":{"id":"/docs/server/setup-state-115","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Placement commits"},"3554":{"id":"/docs/server/setup-state-116","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Needs the network layer; placement is not persisted yet"},"3555":{"id":"/docs/server/setup-state-117","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#what-works-today","content":"Without `streams.alignment: color_to_depth` the server logs\n`setup state not built: client-facing setup requires streams.alignment=color_to_depth`\nand runs the pipeline without a setup state."},"3556":{"id":"/docs/server/setup-state-118","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#related-pages","content":"Camera pose calibration: calibrate, validity rules, troubleshooting"},"3557":{"id":"/docs/server/setup-state-119","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#related-pages","content":"Configuration: `camera_pose_path`, `autocalibrate`"},"3558":{"id":"/docs/server/setup-state-120","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#related-pages","content":"Stream layout: the bundles and descriptors the state describes"},"3559":{"id":"/docs/server/setup-state-121","page_id":"/docs/server/setup-state","tags":[],"type":"text","url":"/docs/server/setup-state#related-pages","content":"Serve to browsers: status of the network layer"},"3560":{"id":"/docs/server/stream-layout","page_id":"/docs/server/stream-layout","type":"page","content":"Stream layout","breadcrumbs":["HSLU OrbbecStreamer","Server","How it works"],"tags":[],"url":"/docs/server/stream-layout"},"3561":{"id":"/docs/server/stream-layout-0","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"Choose between concatenated and per-camera encoding, what each produces, and the encoded colour and depth bitstreams."},"3562":{"id":"/docs/server/stream-layout-1","page_id":"/docs/server/stream-layout","type":"heading","tags":[],"url":"/docs/server/stream-layout#what-each-layout-produces","content":"What each layout produces"},"3563":{"id":"/docs/server/stream-layout-2","page_id":"/docs/server/stream-layout","type":"heading","tags":[],"url":"/docs/server/stream-layout#concatenated_batch","content":"`concatenated_batch`"},"3564":{"id":"/docs/server/stream-layout-3","page_id":"/docs/server/stream-layout","type":"heading","tags":[],"url":"/docs/server/stream-layout#per_camera","content":"`per_camera`"},"3565":{"id":"/docs/server/stream-layout-4","page_id":"/docs/server/stream-layout","type":"heading","tags":[],"url":"/docs/server/stream-layout#trade-offs","content":"Trade-offs"},"3566":{"id":"/docs/server/stream-layout-5","page_id":"/docs/server/stream-layout","type":"heading","tags":[],"url":"/docs/server/stream-layout#switch-the-layout","content":"Switch the layout"},"3567":{"id":"/docs/server/stream-layout-6","page_id":"/docs/server/stream-layout","type":"heading","tags":[],"url":"/docs/server/stream-layout#expected-result","content":"Expected result"},"3568":{"id":"/docs/server/stream-layout-7","page_id":"/docs/server/stream-layout","type":"heading","tags":[],"url":"/docs/server/stream-layout#encoded-bitstreams","content":"Encoded bitstreams"},"3569":{"id":"/docs/server/stream-layout-8","page_id":"/docs/server/stream-layout","type":"heading","tags":[],"url":"/docs/server/stream-layout#troubleshooting","content":"Troubleshooting"},"3570":{"id":"/docs/server/stream-layout-9","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"The stream layout decides how the server packs several cameras into HEVC\nstreams. It is set once in the server config with `encoding.session_mode`.\nClients read it from the stream descriptors and cannot change it."},"3571":{"id":"/docs/server/stream-layout-10","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"Config value (`encoding.session_mode`)"},"3572":{"id":"/docs/server/stream-layout-11","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"Wire value"},"3573":{"id":"/docs/server/stream-layout-12","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"Result"},"3574":{"id":"/docs/server/stream-layout-13","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"`concatenated_batch`"},"3575":{"id":"/docs/server/stream-layout-14","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"`concatenated`"},"3576":{"id":"/docs/server/stream-layout-15","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"All cameras tiled into one colour stream and one depth stream"},"3577":{"id":"/docs/server/stream-layout-16","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"`per_camera` (the code default)"},"3578":{"id":"/docs/server/stream-layout-17","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"`per-camera`"},"3579":{"id":"/docs/server/stream-layout-18","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"One colour stream and one depth stream per camera"},"3580":{"id":"/docs/server/stream-layout-19","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"The parser also accepts `concatenated` and `joint` for `concatenated_batch`,\nand `separate` for `per_camera`. The development config\n`server/config/dev/live.yaml` uses `concatenated_batch`."},"3581":{"id":"/docs/server/stream-layout-20","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout","content":"Serving to browsers over WebTransport is not yet available in the server. The\nlayout already shapes the encoder output, the debug recordings, `setup.json`\nand the stream descriptors the server builds for its setup state. The wire\nmeaning is defined in `protocol/wire-format.md` §5 and §6."},"3582":{"id":"/docs/server/stream-layout-21","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#what-each-layout-produces","content":"Both layouts encode the same synchronised multi-camera batches, and in both\ncolour and depth are separate HEVC streams. Colour is aligned into the depth\nimage, so a colour tile and a depth tile of one camera have the same size\n(640 × 576 with the dev config)."},"3583":{"id":"/docs/server/stream-layout-22","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#concatenated_batch","content":"Camera tiles are placed left to right, in camera order, into one colour\nsurface and one depth surface of `(N × W) × H`. Two cameras at 640 × 576\ngive 1280 × 576."},"3584":{"id":"/docs/server/stream-layout-23","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#concatenated_batch","content":"Exactly two NVENC sessions, one for colour and one for depth."},"3585":{"id":"/docs/server/stream-layout-24","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#concatenated_batch","content":"One bundle for the whole rig, with bundle id `multicam`. Its descriptors\nlist the camera ids and each camera's tile rectangle."},"3586":{"id":"/docs/server/stream-layout-25","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#concatenated_batch","content":"The encoder bitrate is the configured per-camera bitrate times N."},"3587":{"id":"/docs/server/stream-layout-26","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#concatenated_batch","content":"All tiles must have the same size, and the camera set and order cannot\nchange while the server runs."},"3588":{"id":"/docs/server/stream-layout-27","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#concatenated_batch","content":"If a camera's processed frame is missing from a batch, the whole batch is\nskipped."},"3589":{"id":"/docs/server/stream-layout-28","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#per_camera","content":"Each camera has its own colour stream and depth stream of `W × H`."},"3590":{"id":"/docs/server/stream-layout-29","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#per_camera","content":"Two NVENC sessions per camera, `2 × N` in total."},"3591":{"id":"/docs/server/stream-layout-30","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#per_camera","content":"One bundle per camera; the bundle id is the camera `id` from the config."},"3592":{"id":"/docs/server/stream-layout-31","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#per_camera","content":"Each encoder runs at the configured per-camera bitrate."},"3593":{"id":"/docs/server/stream-layout-32","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#per_camera","content":"A missing frame from one camera skips only that camera's frame."},"3594":{"id":"/docs/server/stream-layout-33","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"`concatenated_batch`"},"3595":{"id":"/docs/server/stream-layout-34","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"`per_camera`"},"3596":{"id":"/docs/server/stream-layout-35","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Browser decoders"},"3597":{"id":"/docs/server/stream-layout-36","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"2 in total"},"3598":{"id":"/docs/server/stream-layout-37","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"2 per camera"},"3599":{"id":"/docs/server/stream-layout-38","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"NVENC sessions"},"3600":{"id":"/docs/server/stream-layout-39","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"2"},"3601":{"id":"/docs/server/stream-layout-40","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"2 × N"},"3602":{"id":"/docs/server/stream-layout-41","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Frame size per stream"},"3603":{"id":"/docs/server/stream-layout-42","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Grows with N"},"3604":{"id":"/docs/server/stream-layout-43","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Fixed at one camera"},"3605":{"id":"/docs/server/stream-layout-44","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"HEVC level"},"3606":{"id":"/docs/server/stream-layout-45","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Higher; grows with N (see below)"},"3607":{"id":"/docs/server/stream-layout-46","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Lowest for the camera size"},"3608":{"id":"/docs/server/stream-layout-47","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Keyframes"},"3609":{"id":"/docs/server/stream-layout-48","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"One IDR covers every camera, so a keyframe costs N tiles of bits"},"3610":{"id":"/docs/server/stream-layout-49","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Independent per camera; a client that needs a keyframe for one camera does not force one on the others"},"3611":{"id":"/docs/server/stream-layout-50","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Cross-camera sync"},"3612":{"id":"/docs/server/stream-layout-51","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Built in: one access unit holds every camera of a frame set"},"3613":{"id":"/docs/server/stream-layout-52","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"One bundle per camera; each camera counts its own frame sets, so match cameras by capture timestamp, not by frame-set number"},"3614":{"id":"/docs/server/stream-layout-53","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Missing camera frame"},"3615":{"id":"/docs/server/stream-layout-54","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"The whole frame set is skipped"},"3616":{"id":"/docs/server/stream-layout-55","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Only that camera is skipped"},"3617":{"id":"/docs/server/stream-layout-56","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"**Decoders.** Browsers limit how many hardware video decoders can run at\nonce. Concatenated needs two whatever the camera count."},"3618":{"id":"/docs/server/stream-layout-57","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"**HEVC level.** The server chooses the lowest HEVC level whose picture size,\nsample rate and Main-tier bitrate admit the stream. It uses the whole surface\nand the whole bitrate. With the dev profile (640 × 576 at 15 fps, 12 Mbit/s\ncolour and 8 Mbit/s depth per camera):"},"3619":{"id":"/docs/server/stream-layout-58","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Cameras"},"3620":{"id":"/docs/server/stream-layout-59","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Concatenated colour"},"3621":{"id":"/docs/server/stream-layout-60","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Concatenated depth"},"3622":{"id":"/docs/server/stream-layout-61","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Per-camera colour"},"3623":{"id":"/docs/server/stream-layout-62","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"Per-camera depth"},"3624":{"id":"/docs/server/stream-layout-63","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"1"},"3625":{"id":"/docs/server/stream-layout-64","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"4.0"},"3626":{"id":"/docs/server/stream-layout-65","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"3.1"},"3627":{"id":"/docs/server/stream-layout-66","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"4.0"},"3628":{"id":"/docs/server/stream-layout-67","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"3.1"},"3629":{"id":"/docs/server/stream-layout-68","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"2"},"3630":{"id":"/docs/server/stream-layout-69","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"5.0"},"3631":{"id":"/docs/server/stream-layout-70","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"4.1"},"3632":{"id":"/docs/server/stream-layout-71","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"4.0"},"3633":{"id":"/docs/server/stream-layout-72","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"3.1"},"3634":{"id":"/docs/server/stream-layout-73","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"4"},"3635":{"id":"/docs/server/stream-layout-74","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"5.2"},"3636":{"id":"/docs/server/stream-layout-75","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"5.1"},"3637":{"id":"/docs/server/stream-layout-76","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"4.0"},"3638":{"id":"/docs/server/stream-layout-77","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"3.1"},"3639":{"id":"/docs/server/stream-layout-78","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"The level is part of the codec string sent to the browser, for example\n`hev1.1.6.L150.B0` for level 5.0 colour. Check that the browser can decode\nthe level before adding cameras. At high bitrates the level is set by the\nbitrate, not the picture size, so lowering `bitrate_bps` also lowers it."},"3640":{"id":"/docs/server/stream-layout-79","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"**Width limit.** A concatenated surface is `N × W` wide. The NVENC HEVC\nmaximum is reported by the capability test and is 8192 × 8192 on current\nGPUs, which allows 12 tiles of 640 pixels. Browser decoders may accept less."},"3641":{"id":"/docs/server/stream-layout-80","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"**Keyframes.** Every stream starts with an IDR frame and repeats one every\n`encoding.gop_length` frames (60 frames is 4 s at 15 fps; `0` disables the\nperiod). The encoder can also force a keyframe on request, which serving\nwill use when a client joins or after it drops data for a slow client. Forced\nkeyframes for one bundle are at least\n250 ms apart. Within a bundle, colour and depth are always keyframes on the\nsame frame set."},"3642":{"id":"/docs/server/stream-layout-81","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#trade-offs","content":"**Latency.** Both layouts encode each synchronised batch on one encoder\nthread with the same low-latency settings: CBR, a one-frame buffer, no\nB-frames and no look-ahead. Concatenated produces one larger frame per batch;\nper-camera produces N smaller frames one after another. Measure your rig with\nthe latency log rather than assuming one is faster."},"3643":{"id":"/docs/server/stream-layout-82","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#switch-the-layout","content":"Edit `encoding.session_mode` in your config:"},"3644":{"id":"/docs/server/stream-layout-83","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#switch-the-layout","content":"Restart the server. The layout cannot change while it runs:"},"3645":{"id":"/docs/server/stream-layout-84","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#expected-result","content":"The start-up log shows the layout and the per-camera bitrates:"},"3646":{"id":"/docs/server/stream-layout-85","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#expected-result","content":"After the cameras start, `debug/live/setup.json` contains\n`\"session_mode\": \"concatenated_batch\"` or `\"per_camera\"`. With\n`debug_recording.record_gpu_outputs: true`, encoded output is written to\n`debug/live/multicam/` in concatenated mode and to\n`debug/live/<camera id>/` in per-camera mode. Each output directory also gets\na `gpu-output-layout.json` that describes the surface and its tiles."},"3647":{"id":"/docs/server/stream-layout-86","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"This describes how the server produces what the contract specifies. The\nnormative definition is `protocol/wire-format.md` (§4 records, §6\ndescriptors, §8 depth quantization)."},"3648":{"id":"/docs/server/stream-layout-87","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"**Colour**"},"3649":{"id":"/docs/server/stream-layout-88","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"HEVC Main, 8-bit 4:2:0, `hev1` sample format; codec string\n`hev1.1.6.L<level>.B0`."},"3650":{"id":"/docs/server/stream-layout-89","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"Input is the RGB8 frame after colour-to-depth alignment, converted on the\nGPU to NV12, BT.709 limited range (signalled in the VUI)."},"3651":{"id":"/docs/server/stream-layout-90","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"Colour is not masked."},"3652":{"id":"/docs/server/stream-layout-91","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"**Depth: `QuantizedP010V1`**"},"3653":{"id":"/docs/server/stream-layout-92","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"HEVC Main10, P010 4:2:0, `hev1`; codec string `hev1.2.4.L<level>.B0`.\nFull range, no colour description in the VUI."},"3654":{"id":"/docs/server/stream-layout-93","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"Same tiling and size as colour. There is a single plane of codes; the\nsurface height equals the image height."},"3655":{"id":"/docs/server/stream-layout-94","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"Luma holds one 10-bit code per depth pixel, stored as `code << 6` in the\n16-bit P010 sample. Chroma is neutral (`512 << 6`)."},"3656":{"id":"/docs/server/stream-layout-95","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"The code is looked up from the active depth quantization profile (linear,\nor calibrated with the depth calibrator; see\nConfiguration). Pixels outside the foreground mask get\ncode 0."},"3657":{"id":"/docs/server/stream-layout-96","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"Codes: `0` invalid or masked, `1` below `minimum_depth_mm`, `2..1022`\nvalid depth, `1023` above `maximum_depth_mm`. Clients reconstruct\nmillimetres only through the transmitted 1024-entry reconstruction LUT.\nThe encode LUT never leaves the server."},"3658":{"id":"/docs/server/stream-layout-97","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"**Both channels**"},"3659":{"id":"/docs/server/stream-layout-98","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"Parameter sets (VPS/SPS/PPS) are repeated in-band on every IDR."},"3660":{"id":"/docs/server/stream-layout-99","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#encoded-bitstreams","content":"The coded size equals the logical size; any encoder padding is removed\nthrough the SPS conformance window."},"3661":{"id":"/docs/server/stream-layout-100","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"Problem"},"3662":{"id":"/docs/server/stream-layout-101","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"Fix"},"3663":{"id":"/docs/server/stream-layout-102","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"`Unsupported encoding session_mode: <value>`"},"3664":{"id":"/docs/server/stream-layout-103","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"Use `concatenated_batch` or `per_camera` (or an alias listed above)."},"3665":{"id":"/docs/server/stream-layout-104","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"`Concatenated NVENC requires identical camera geometries`"},"3666":{"id":"/docs/server/stream-layout-105","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"All cameras must use the same stream profile. They share `streams`, so check that every camera supports it."},"3667":{"id":"/docs/server/stream-layout-106","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"`Concatenated camera order or geometry changed after NVENC initialization`"},"3668":{"id":"/docs/server/stream-layout-107","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"A camera dropped out or came back while running. Restart the server."},"3669":{"id":"/docs/server/stream-layout-108","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"`no HEVC level up to 6.2 admits ...`"},"3670":{"id":"/docs/server/stream-layout-109","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"The concatenated surface or bitrate is too large. Lower `bitrate_bps`, use fewer cameras or switch to `per_camera`."},"3671":{"id":"/docs/server/stream-layout-110","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"NVENC fails to open a session with many cameras in `per_camera`"},"3672":{"id":"/docs/server/stream-layout-111","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"Consumer GeForce drivers cap concurrent NVENC sessions. Use `concatenated_batch`, which needs two."},"3673":{"id":"/docs/server/stream-layout-112","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"The browser cannot decode the stream"},"3674":{"id":"/docs/server/stream-layout-113","page_id":"/docs/server/stream-layout","tags":[],"type":"text","url":"/docs/server/stream-layout#troubleshooting","content":"Compare the codec string's level with what the browser supports; lower the bitrate or the camera count, or use `per_camera`."},"3675":{"id":"/docs/server/telemetry","page_id":"/docs/server/telemetry","type":"page","content":"Read the telemetry","breadcrumbs":["HSLU OrbbecStreamer","Server","Operate"],"tags":[],"url":"/docs/server/telemetry"},"3676":{"id":"/docs/server/telemetry-0","page_id":"/docs/server/telemetry","tags":[],"type":"text","url":"/docs/server/telemetry","content":"What every periodic log line of the live server means, what healthy numbers look like, and how to act on drops, skew and queueing."},"3677":{"id":"/docs/server/telemetry-1","page_id":"/docs/server/telemetry","type":"heading","tags":[],"url":"/docs/server/telemetry#choose-the-display-mode","content":"Choose the display mode"},"3678":{"id":"/docs/server/telemetry-2","page_id":"/docs/server/telemetry","type":"heading","tags":[],"url":"/docs/server/telemetry#rate-tables","content":"Rate tables"},"3679":{"id":"/docs/server/telemetry-3","page_id":"/docs/server/telemetry","type":"heading","tags":[],"url":"/docs/server/telemetry#live-pipeline","content":"`LIVE PIPELINE`"},"3680":{"id":"/docs/server/telemetry-4","page_id":"/docs/server/telemetry","type":"heading","tags":[],"url":"/docs/server/telemetry#camera-ingress","content":"`CAMERA INGRESS`"},"3681":{"id":"/docs/server/telemetry-5","page_id":"/docs/server/telemetry","type":"heading","tags":[],"url":"/docs/server/telemetry#debug-recording-rates","content":"`DEBUG RECORDING RATES`"},"3682":{"id":"/docs/server/telemetry-6","page_id":"/docs/server/telemetry","type":"heading","tags":[],"url":"/docs/server/telemetry#latency-report","content":"Latency report"},"3683":{"id":"/docs/server/telemetry-7","page_id":"/docs/server/telemetry","type":"heading","tags":[],"url":"/docs/server/telemetry#metrics","content":"Metrics"},"3684":{"id":"/docs/server/telemetry-8","page_id":"/docs/server/telemetry","type":"heading","tags":[],"url":"/docs/server/telemetry#session-summary","content":"Session summary"},"3685":{"id":"/docs/server/telemetry-9","page_id":"/docs/server/telemetry","type":"heading","tags":[],"url":"/docs/server/telemetry#what-good-looks-like","content":"What good looks like"},"3686":{"id":"/docs/server/telemetry-10","page_id":"/docs/server/telemetry","type":"heading","tags":[],"url":"/docs/server/telemetry#troubleshooting","content":"Troubleshooting"},"3687":{"id":"/docs/server/telemetry-11","page_id":"/docs/server/telemetry","tags":[],"type":"text","url":"/docs/server/telemetry","content":"While `--live` runs, the server prints three kinds of telemetry to the\nterminal:"},"3688":{"id":"/docs/server/telemetry-12","page_id":"/docs/server/telemetry","tags":[],"type":"text","url":"/docs/server/telemetry","content":"Output"},"3689":{"id":"/docs/server/telemetry-13","page_id":"/docs/server/telemetry","tags":[],"type":"text","url":"/docs/server/telemetry","content":"When"},"3690":{"id":"/docs/server/telemetry-14","page_id":"/docs/server/telemetry","tags":[],"type":"text","url":"/docs/server/telemetry","content":"Content"},"3691":{"id":"/docs/server/telemetry-15","page_id":"/docs/server/telemetry","tags":[],"type":"text","url":"/docs/server/telemetry","content":"Rate tables (`LIVE PIPELINE`, `CAMERA INGRESS`, `DEBUG RECORDING RATES`)"},"3692":{"id":"/docs/server/telemetry-16","page_id":"/docs/server/telemetry"